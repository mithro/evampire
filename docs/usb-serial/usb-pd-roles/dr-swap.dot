    t18 [pos="6.00,-3.49!", shape=plaintext, label="on Reject: evampire stays DFP,\nD+ and D− undriven, pull-up off", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    p20 [pos="1.20,0.14!"];
