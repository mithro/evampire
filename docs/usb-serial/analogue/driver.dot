// Full-speed driver for one line (D+; D- is the same): a CMOS output
// stage with tri-state enable, the series resistor, the pin and the 50 pF
// test load of the specification.
//
// Fixed grid (positions in inches): the signal runs along y=1.6 from the
// logic on the left to the pin and test load on the right.
//
// SPDX-License-Identifier: Apache-2.0

digraph driver {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica", size="7.4,3.5"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=1.3, height=0.6,
           fixedsize=true];
    edge  [arrowsize=0.7, penwidth=1.5];

    chip  [pos="2.55,1.55!", width=4.9, height=2.2, label="evampire",
           labelloc=t, style="rounded,bold", color="#1f4e79",
           fontcolor="#1f4e79", fillcolor="none", fontsize=12];

    logic [pos="0.85,1.6!", width=1.2, label="data and\noutput enable",
           fillcolor="#dbe8f5"];
    pre   [pos="2.35,1.6!", width=1.4, label="pre-driver,\nedge-rate control",
           fillcolor="#fbe5d6"];
    out   [pos="3.95,1.6!", width=1.45, height=0.85,
           label="output stage:\nPMOS to 3.3 V,\nNMOS to ground,\noff = tri-state",
           fillcolor="#fbe5d6"];
    rs    [pos="5.6,1.6!", width=0.9, label="RS", fillcolor="#ffffff"];
    pin   [pos="6.65,1.6!", width=0.75, label="D+ pin", fillcolor="#ffffff"];
    cl    [pos="6.65,0.55!", width=1.05, label="50 pF\ntest load",
           fillcolor="#ffffff", style="rounded,filled,dashed"];

    node  [shape=plaintext, style="", fontsize=10, width=1.0, height=0.2];
    z_l   [pos="4.65,2.95!", width=3.6,
           label="ZDRV: 28 Ω to 44 Ω, output stage and RS together"];
    on_l  [pos="5.6,1.18!", width=1.1, label="on chip or board"];
    g_l   [pos="6.65,-0.02!", width=0.7, label="ground"];
    d_l   [pos="2.6,0.25!", width=3.6, label="D− has the same driver, with opposite data"];

    node  [shape=point, width=0.01, height=0.01, label=""];
    b1    [pos="3.25,2.75!"];
    b2    [pos="6.05,2.75!"];
    b1a   [pos="3.25,2.6!"];
    b2a   [pos="6.05,2.6!"];
    jp    [pos="6.65,1.15!"];
    g     [pos="6.65,0.12!"];

    logic -> pre;  pre -> out;  out -> rs [arrowhead=none];
    rs -> pin [arrowhead=none];  pin -> cl [arrowhead=none];
    cl -> g [arrowhead=none];
    b1a -> b1 [arrowhead=none, penwidth=1];  b1 -> b2 [arrowhead=none, penwidth=1];
    b2 -> b2a [arrowhead=none, penwidth=1];
}
