// A short from VBUS to D+ while the pad's output stage runs from 3.3 V:
// with the driver off, the pad diode to the supply conducts and only the
// series resistor RS, outside the pad diode, limits the current.
//
// Fixed grid (positions in inches): the fault path runs left to right
// along y=1.5 from VBUS to the pad, then up through the diode to the
// 3.3 V supply at y=2.7.
//
// SPDX-License-Identifier: Apache-2.0

digraph short_circuit {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica", size="7.4,3.6"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=1.2, height=0.55,
           fixedsize=true];
    edge  [penwidth=1.5, arrowsize=0.7];

    chip  [pos="5.45,1.75!", width=3.3, height=2.6, label="evampire",
           labelloc=b, style="rounded,bold", color="#1f4e79",
           fontcolor="#1f4e79", fillcolor="none", fontsize=12];

    vbus  [pos="0.7,1.5!", width=1.1, label="VBUS\n5.25 V", fillcolor="#ffffff"];
    sh    [pos="1.95,1.5!", width=1.0, label="short to D+", fillcolor="#f4cccc"];
    rs    [pos="3.3,1.5!", width=1.3, label="RS, outside\nthe pad diode",
           fillcolor="#ffffff"];
    diode [pos="4.65,2.15!", width=1.15, label="pad diode,\nforward biased",
           fillcolor="#fbe5d6"];
    vdd   [pos="6.2,2.7!", width=1.35, label="3.3 V pad supply", fillcolor="#dbe8f5"];
    stage [pos="6.2,1.5!", width=1.5, label="output stage (off)\nand receivers",
           fillcolor="#fbe5d6"];

    node  [shape=plaintext, style="", fontsize=10, width=1.0, height=0.2];
    pad_l [pos="4.65,1.32!", width=0.5, label="pad"];
    i_l   [pos="2.0,0.6!", width=3.3, height=0.35, fontcolor="#c0392b",
           label="I = (5.25 − 3.3 − 0.6) V / RS\n= 31 mA to 48 mA for RS of 28 Ω to 44 Ω"];

    node  [shape=point, width=0.08, height=0.08, label="", style=filled,
           fillcolor=black];
    pad   [pos="4.65,1.5!"];
    k1    [pos="4.65,2.7!", width=0.01];

    edge  [color="#c0392b", penwidth=3];
    vbus -> sh [arrowhead=none];  sh -> rs;  rs -> pad [arrowhead=none];
    pad -> diode;  diode -> k1 [arrowhead=none];  k1 -> vdd;
    edge  [color="#000000", penwidth=1.5, arrowhead=none];
    pad -> stage;
}
