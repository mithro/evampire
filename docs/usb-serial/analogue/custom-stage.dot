// A custom output stage that survives a 5.25 V short on the pad while the
// driver is off: a tracking block holds the PMOS n-well at the higher of
// the pad and the 3.3 V supply, the pad's ESD diode has its cathode on that
// tracked well instead of on 3.3 V, and a pass gate lifts the off PMOS's
// gate to the pad voltage, which the 3.3 V pre-driver cannot.
//
// Fixed grid (positions in inches): supply at the top (y=3.7), the PMOS
// row at y=2.6, the output node along y=1.75, ground at the bottom
// (y=0.2). Dashed blue lines are the tracked n-well and its sense inputs.
//
// SPDX-License-Identifier: Apache-2.0

graph custom_stage {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,4.5"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=1.5, height=0.55,
           fixedsize=true];
    edge  [penwidth=1.5];

    vdd  [pos="3.0,3.7!", width=1.3, label="3.3 V supply", fillcolor="#dbe8f5"];
    pmos [pos="3.0,2.6!", label="PMOS pull-up,\n6 V device", fillcolor="#fbe5d6"];
    nmos [pos="3.0,0.95!", label="NMOS pull-down,\n6 V device", fillcolor="#fbe5d6"];
    trk  [pos="0.75,2.6!", width=1.3, height=0.8,
          label="well tracking:\nhigher of pad\nand supply", fillcolor="#e2f0d9"];
    esd  [pos="1.85,2.17!", width=0.6, height=0.45, fontsize=10,
          label="ESD\ndiode", fillcolor="#fbe5d6"];
    pg   [pos="5.0,2.6!", width=1.3, label="pass gate:\npad to gate", fillcolor="#e2f0d9"];
    pre  [pos="5.0,3.5!", width=1.3, label="pre-driver,\n3.3 V", fillcolor="#fbe5d6"];
    pad  [pos="6.3,1.75!", width=0.9, label="pad\n(D+ or D−)", fillcolor="#ffffff"];
    vb   [pos="6.3,0.75!", width=1.25, label="short to VBUS,\n5.25 V", fillcolor="#f4cccc"];

    node [shape=plaintext, style="", fontsize=11, width=1.2, height=0.2];
    g_l  [pos="3.0,0.05!", width=0.8, label="ground"];
    w_l  [pos="1.85,2.82!", width=1.0, fontcolor="#1f4e79", label="tracked\nn-well", height=0.35];
    gt_l [pos="4.15,2.78!", width=0.5, label="gate"];
    nt   [pos="3.4,-0.5!", width=7.0, height=0.55,
          label="Blocks the short only while the driver is off. With the n-well, the ESD\ndiode's cathode or the gate at 3.3 V, the drain-to-well diode, the ESD\ndiode or the channel would conduct from the pad into the supply."];

    node [shape=point, width=0.07, height=0.07, label="", style=filled, fillcolor=black];
    k1  [pos="3.0,1.75!"];
    j1  [pos="1.85,2.6!"];
    j2  [pos="1.85,1.75!"];
    gj  [pos="4.1,2.6!"];
    gb  [pos="3.0,0.2!", width=0.01];
    c1  [pos="0.75,3.7!", width=0.01];
    c4  [pos="0.75,1.75!", width=0.01];
    c5  [pos="6.3,2.6!", width=0.01];
    c7  [pos="4.1,3.5!", width=0.01];

    vdd -- pmos -- k1 -- nmos -- gb;
    k1 -- pad;  pad -- vb [style=dashed, color="#c0392b"];
    trk -- j1 [style=dashed, color="#1f4e79"];
    j1 -- pmos [style=dashed, color="#1f4e79"];
    j1 -- esd [color="#1f4e79"];  esd -- j2;
    vdd -- c1 [style=dashed, color="#1f4e79"];  c1 -- trk [style=dashed, color="#1f4e79"];
    c4 -- trk [style=dashed, color="#1f4e79"];
    c4 -- j2 [style=dashed, color="#1f4e79"];  j2 -- k1;
    pmos -- gj;  gj -- pg;  pg -- c5;  c5 -- pad;
    pre -- c7;  c7 -- gj;
}
