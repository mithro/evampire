// Stages of a control transfer that reads data, such as GET_DESCRIPTOR.
// Generated by sequences.py (do not edit by hand). Time runs
// downwards and is not to scale.
//
// SPDX-License-Identifier: Apache-2.0

digraph control_transfer {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica", outputorder=edgesfirst, size="7.4,30"];
    node  [shape=point, width=0.01, height=0.01, label="", fontname="Helvetica"];
    edge  [arrowsize=0.7, penwidth=1.3];

    h27 [pos="1.20,0.35!", shape=box, style="rounded,filled", fillcolor="#dbe8f5", label="Host", width=1.3, height=0.42, fontsize=11];
    h30 [pos="4.20,0.35!", shape=box, style="rounded,filled", fillcolor="#fbe5d6", label="Device", width=1.3, height=0.42, fontsize=11];
    t1 [pos="2.70,-0.46!", shape=plaintext, label="Setup stage", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p2 [pos="1.20,-0.88!"];
    p3 [pos="4.20,-0.88!"];
    p2 -> p3 [color="#000000", style=solid];
    t4 [pos="2.70,-0.75!", shape=plaintext, label="SETUP, DATA0 (8-byte request)", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p5 [pos="4.20,-1.30!"];
    p6 [pos="1.20,-1.30!"];
    p5 -> p6 [color="#000000", style=solid];
    t7 [pos="2.70,-1.17!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t8 [pos="2.70,-1.76!", shape=plaintext, label="Data stage: IN transactions", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p9 [pos="1.20,-2.18!"];
    p10 [pos="4.20,-2.18!"];
    p9 -> p10 [color="#000000", style=solid];
    t11 [pos="2.70,-2.05!", shape=plaintext, label="IN", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p12 [pos="4.20,-2.60!"];
    p13 [pos="1.20,-2.60!"];
    p12 -> p13 [color="#000000", style=solid];
    t14 [pos="2.70,-2.47!", shape=plaintext, label="DATA1", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p15 [pos="1.20,-3.02!"];
    p16 [pos="4.20,-3.02!"];
    p15 -> p16 [color="#000000", style=solid];
    t17 [pos="2.70,-2.89!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t18 [pos="6.00,-3.02!", shape=plaintext, label="repeated, DATA0/DATA1\nalternating, until all is sent", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    t19 [pos="2.70,-3.49!", shape=plaintext, label="Status stage: opposite direction", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p20 [pos="1.20,-3.91!"];
    p21 [pos="4.20,-3.91!"];
    p20 -> p21 [color="#000000", style=solid];
    t22 [pos="2.70,-3.78!", shape=plaintext, label="OUT, zero-length DATA1", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p23 [pos="4.20,-4.33!"];
    p24 [pos="1.20,-4.33!"];
    p23 -> p24 [color="#000000", style=solid];
    t25 [pos="2.70,-4.20!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t26 [pos="6.00,-4.33!", shape=plaintext, label="a request that writes data\nends with an IN status stage", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    p28 [pos="1.20,0.14!"];
    p29 [pos="1.20,-4.66!"];
    p28 -> p29 [arrowhead=none, style=dashed, color="#999999"];
    p31 [pos="4.20,0.14!"];
    p32 [pos="4.20,-4.66!"];
    p31 -> p32 [arrowhead=none, style=dashed, color="#999999"];
}
