// A lost ACK and the DATA0/DATA1 sequence bit; a missing reply counted as an error.
// Generated by sequences.py (do not edit by hand). Time runs
// downwards and is not to scale.
//
// SPDX-License-Identifier: Apache-2.0

digraph retry {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica", outputorder=edgesfirst, size="7.4,30"];
    node  [shape=point, width=0.01, height=0.01, label="", fontname="Helvetica"];
    edge  [arrowsize=0.7, penwidth=1.3];

    h31 [pos="1.20,0.35!", shape=box, style="rounded,filled", fillcolor="#dbe8f5", label="Host", width=1.3, height=0.42, fontsize=11];
    h34 [pos="4.20,0.35!", shape=box, style="rounded,filled", fillcolor="#fbe5d6", label="Device", width=1.3, height=0.42, fontsize=11];
    t1 [pos="2.70,-0.46!", shape=plaintext, label="Lost ACK: the copy is recognised", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p2 [pos="1.20,-0.88!"];
    p3 [pos="4.20,-0.88!"];
    p2 -> p3 [color="#000000", style=solid];
    t4 [pos="2.70,-0.75!", shape=plaintext, label="OUT token", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p5 [pos="1.20,-1.30!"];
    p6 [pos="4.20,-1.30!"];
    p5 -> p6 [color="#000000", style=solid];
    t7 [pos="2.70,-1.17!", shape=plaintext, label="DATA1", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t8 [pos="6.00,-1.30!", shape=plaintext, label="device expects DATA1: stores it,\nnow expects DATA0", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    p9 [pos="4.20,-1.72!"];
    p10 [pos="2.70,-1.72!"];
    p9 -> p10 [arrowhead=none, color="#000000", style=solid];
    t11 [pos="2.58,-1.72!", shape=plaintext, label="✕", width=0.2, height=0.17, fontsize=12, fontcolor="#c0392b"];
    t12 [pos="2.70,-1.59!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t13 [pos="6.00,-1.72!", shape=plaintext, label="ACK lost on the way", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p14 [pos="1.20,-2.14!"];
    p15 [pos="4.20,-2.14!"];
    p14 -> p15 [color="#000000", style=solid];
    t16 [pos="2.70,-2.01!", shape=plaintext, label="OUT token", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t17 [pos="6.00,-2.14!", shape=plaintext, label="host repeats the transaction", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p18 [pos="1.20,-2.56!"];
    p19 [pos="4.20,-2.56!"];
    p18 -> p19 [color="#000000", style=solid];
    t20 [pos="2.70,-2.43!", shape=plaintext, label="DATA1", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t21 [pos="6.00,-2.56!", shape=plaintext, label="DATA1 again: a copy, not stored twice", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p22 [pos="4.20,-2.98!"];
    p23 [pos="1.20,-2.98!"];
    p22 -> p23 [color="#000000", style=solid];
    t24 [pos="2.70,-2.85!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t25 [pos="2.70,-3.44!", shape=plaintext, label="Packet with an error: no reply", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p26 [pos="1.20,-3.86!"];
    p27 [pos="4.20,-3.86!"];
    p26 -> p27 [color="#c0392b", style=solid];
    t28 [pos="2.70,-3.73!", shape=plaintext, label="IN token (bad CRC)", width=2.4, height=0.17, fontsize=10, fontcolor="#c0392b"];
    t29 [pos="6.00,-4.28!", shape=plaintext, label="device sends nothing; the host\ncounts an error and retries", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    t30 [pos="6.00,-4.70!", shape=plaintext, label="after three errors in a row\nthe host gives up the transfer", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    p32 [pos="1.20,0.14!"];
    p33 [pos="1.20,-5.04!"];
    p32 -> p33 [arrowhead=none, style=dashed, color="#999999"];
    p35 [pos="4.20,0.14!"];
    p36 [pos="4.20,-5.04!"];
    p35 -> p36 [arrowhead=none, style=dashed, color="#999999"];
}
