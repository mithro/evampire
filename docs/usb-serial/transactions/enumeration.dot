// Enumeration of a full-speed device, with the time limits of USB 2.0.
// Generated by sequences.py (do not edit by hand). Time runs
// downwards and is not to scale.
//
// SPDX-License-Identifier: Apache-2.0

digraph enumeration {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica", outputorder=edgesfirst];
    node  [shape=point, width=0.01, height=0.01, label="", fontname="Helvetica"];
    edge  [arrowsize=0.7, penwidth=1.3];

    h37 [pos="1.20,0.35!", shape=box, style="rounded,filled", fillcolor="#dbe8f5", label="Host", width=1.3, height=0.42, fontsize=11];
    h40 [pos="4.20,0.35!", shape=box, style="rounded,filled", fillcolor="#fbe5d6", label="Device", width=1.3, height=0.42, fontsize=11];
    t1 [pos="6.90,-0.42!", shape=plaintext, label="VBUS valid", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    t2 [pos="5.15,-0.84!", shape=box, style="rounded,filled", fillcolor="#f2f2f2", label="D+ pull-up on within\n100 ms (TSIGATT)", width=1.5, height=0.46, fontsize=9];
    t3 [pos="0.25,-1.26!", shape=box, style="rounded,filled", fillcolor="#f2f2f2", label="wait at least\n100 ms (TATTDB)", width=1.5, height=0.46, fontsize=9];
    p4 [pos="1.20,-1.68!"];
    p5 [pos="4.20,-1.68!"];
    p4 -> p5 [color="#000000", style=solid];
    t6 [pos="2.70,-1.55!", shape=plaintext, label="reset: SE0 for at least 10 ms", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t7 [pos="6.90,-1.68!", shape=plaintext, label="TDRST", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    t8 [pos="0.25,-2.10!", shape=box, style="rounded,filled", fillcolor="#f2f2f2", label="10 ms recovery\n(TRSTRCY)", width=1.5, height=0.46, fontsize=9];
    p9 [pos="1.20,-2.52!"];
    p10 [pos="4.20,-2.52!"];
    p9 -> p10 [color="#000000", style=solid];
    t11 [pos="2.70,-2.39!", shape=plaintext, label="GET_DESCRIPTOR (device), address 0", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p12 [pos="4.20,-2.94!"];
    p13 [pos="1.20,-2.94!"];
    p12 -> p13 [color="#000000", style=solid];
    t14 [pos="2.70,-2.81!", shape=plaintext, label="first bytes: endpoint 0 packet size", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p15 [pos="1.20,-3.36!"];
    p16 [pos="4.20,-3.36!"];
    p15 -> p16 [color="#000000", style=solid];
    t17 [pos="2.70,-3.23!", shape=plaintext, label="SET_ADDRESS", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p18 [pos="4.20,-3.78!"];
    p19 [pos="1.20,-3.78!"];
    p18 -> p19 [color="#000000", style=solid];
    t20 [pos="2.70,-3.65!", shape=plaintext, label="status", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t21 [pos="6.90,-3.78!", shape=plaintext, label="complete within 50 ms;\nnew address 2 ms later", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    p22 [pos="1.20,-4.20!"];
    p23 [pos="4.20,-4.20!"];
    p22 -> p23 [color="#000000", style=solid];
    t24 [pos="2.70,-4.07!", shape=plaintext, label="GET_DESCRIPTOR, full", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t25 [pos="6.90,-4.20!", shape=plaintext, label="device, configuration and\nstring descriptors", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    p26 [pos="4.20,-4.62!"];
    p27 [pos="1.20,-4.62!"];
    p26 -> p27 [color="#000000", style=solid];
    t28 [pos="2.70,-4.49!", shape=plaintext, label="descriptors", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t29 [pos="6.90,-4.62!", shape=plaintext, label="each data packet within 500 ms", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p30 [pos="1.20,-5.04!"];
    p31 [pos="4.20,-5.04!"];
    p30 -> p31 [color="#000000", style=solid];
    t32 [pos="2.70,-4.91!", shape=plaintext, label="SET_CONFIGURATION", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p33 [pos="4.20,-5.46!"];
    p34 [pos="1.20,-5.46!"];
    p33 -> p34 [color="#000000", style=solid];
    t35 [pos="2.70,-5.33!", shape=plaintext, label="status", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t36 [pos="6.90,-5.46!", shape=plaintext, label="the other endpoints now work", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p38 [pos="1.20,0.14!"];
    p39 [pos="1.20,-5.80!"];
    p38 -> p39 [arrowhead=none, style=dashed, color="#999999"];
    p41 [pos="4.20,0.14!"];
    p42 [pos="4.20,-5.80!"];
    p41 -> p42 [arrowhead=none, style=dashed, color="#999999"];
}
