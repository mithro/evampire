// The three kinds of transaction a full-speed serial port uses.
// Generated by sequences.py (do not edit by hand). Time runs
// downwards and is not to scale.
//
// SPDX-License-Identifier: Apache-2.0

digraph transactions {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica", outputorder=edgesfirst, size="7.4,30"];
    node  [shape=point, width=0.01, height=0.01, label="", fontname="Helvetica"];
    edge  [arrowsize=0.7, penwidth=1.3];

    h35 [pos="1.20,0.35!", shape=box, style="rounded,filled", fillcolor="#dbe8f5", label="Host", width=1.3, height=0.42, fontsize=11];
    h38 [pos="4.20,0.35!", shape=box, style="rounded,filled", fillcolor="#fbe5d6", label="Device", width=1.3, height=0.42, fontsize=11];
    t1 [pos="2.70,-0.46!", shape=plaintext, label="SETUP transaction", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p2 [pos="1.20,-0.88!"];
    p3 [pos="4.20,-0.88!"];
    p2 -> p3 [color="#000000", style=solid];
    t4 [pos="2.70,-0.75!", shape=plaintext, label="SETUP token", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p5 [pos="1.20,-1.30!"];
    p6 [pos="4.20,-1.30!"];
    p5 -> p6 [color="#000000", style=solid];
    t7 [pos="2.70,-1.17!", shape=plaintext, label="DATA0, 8-byte request", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p8 [pos="4.20,-1.72!"];
    p9 [pos="1.20,-1.72!"];
    p8 -> p9 [color="#000000", style=solid];
    t10 [pos="2.70,-1.59!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t11 [pos="6.00,-1.72!", shape=plaintext, label="always ACK; never NAK or STALL", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    t12 [pos="2.70,-2.18!", shape=plaintext, label="OUT transaction", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p13 [pos="1.20,-2.60!"];
    p14 [pos="4.20,-2.60!"];
    p13 -> p14 [color="#000000", style=solid];
    t15 [pos="2.70,-2.47!", shape=plaintext, label="OUT token", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p16 [pos="1.20,-3.02!"];
    p17 [pos="4.20,-3.02!"];
    p16 -> p17 [color="#000000", style=solid];
    t18 [pos="2.70,-2.89!", shape=plaintext, label="DATA0 or DATA1", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p19 [pos="4.20,-3.44!"];
    p20 [pos="1.20,-3.44!"];
    p19 -> p20 [color="#000000", style=solid];
    t21 [pos="2.70,-3.31!", shape=plaintext, label="ACK, NAK or STALL", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t22 [pos="6.00,-3.44!", shape=plaintext, label="ACK: taken; NAK: no room yet;\nSTALL: endpoint halted", width=2.6, height=0.34, fontsize=10, fontcolor="#333333"];
    t23 [pos="2.70,-3.91!", shape=plaintext, label="IN transaction", width=3.2, height=0.17, fontsize=11, fontcolor="#1f4e79", fontname="Helvetica-Bold"];
    p24 [pos="1.20,-4.33!"];
    p25 [pos="4.20,-4.33!"];
    p24 -> p25 [color="#000000", style=solid];
    t26 [pos="2.70,-4.20!", shape=plaintext, label="IN token", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    p27 [pos="4.20,-4.75!"];
    p28 [pos="1.20,-4.75!"];
    p27 -> p28 [color="#000000", style=solid];
    t29 [pos="2.70,-4.62!", shape=plaintext, label="DATA0 or DATA1, or NAK or STALL", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t30 [pos="6.00,-4.75!", shape=plaintext, label="NAK: no data ready", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p31 [pos="1.20,-5.17!"];
    p32 [pos="4.20,-5.17!"];
    p31 -> p32 [color="#000000", style=solid];
    t33 [pos="2.70,-5.04!", shape=plaintext, label="ACK", width=2.4, height=0.17, fontsize=10, fontcolor="#000000"];
    t34 [pos="6.00,-5.17!", shape=plaintext, label="only after a data packet", width=2.6, height=0.17, fontsize=10, fontcolor="#333333"];
    p36 [pos="1.20,0.14!"];
    p37 [pos="1.20,-5.50!"];
    p36 -> p37 [arrowhead=none, style=dashed, color="#999999"];
    p39 [pos="4.20,0.14!"];
    p40 [pos="4.20,-5.50!"];
    p39 -> p40 [arrowhead=none, style=dashed, color="#999999"];
}
