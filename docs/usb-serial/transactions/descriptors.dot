// Descriptors of a CDC-ACM serial port, as a tree: the device descriptor,
// the configuration with its two interfaces and their endpoints, and
// endpoint 0, which every device has and which carries the ACM requests.
//
// Fixed grid (positions in inches): one row per descriptor, 0.72 apart,
// indented 0.45 per level; endpoint 0 sits to the right.
//
// SPDX-License-Identifier: Apache-2.0

digraph descriptors {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,6"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=11, fixedsize=true];
    edge  [arrowsize=0.6, penwidth=1.3];

    n0 [pos="2.28,5.40!", width=4.15, height=0.5, label="Device descriptor: class 02h (communications device)", fillcolor="#dbe8f5"];
    n1 [pos="1.75,4.68!", width=2.2, height=0.5, label="Configuration descriptor", fillcolor="#dbe8f5"];
    n2 [pos="3.18,3.96!", width=4.15, height=0.6, label="Communications interface: class 02h, subclass 02h\n(abstract control model), protocol 00h", fillcolor="#fbe5d6"];
    n3 [pos="3.53,3.24!", width=3.95, height=0.6, label="Functional descriptors: Header, Call Management,\nAbstract Control Management, Union", fillcolor="#ffffff"];
    n4 [pos="3.05,2.52!", width=3.0, height=0.5, label="Interrupt IN endpoint: notifications", fillcolor="#e2f0d9"];
    n5 [pos="2.20,1.80!", width=2.2, height=0.5, label="Data interface: class 0Ah", fillcolor="#fbe5d6"];
    n6 [pos="3.05,1.08!", width=3.0, height=0.5, label="Bulk IN endpoint: data to the host", fillcolor="#e2f0d9"];
    n7 [pos="3.05,0.36!", width=3.0, height=0.5, label="Bulk OUT endpoint: data from the host", fillcolor="#e2f0d9"];
    ep0 [pos="6.05,4.68!", width=2.75, height=0.85, fillcolor="#f2f2f2",
         label="Endpoint 0, control, in every\ndevice: SET_LINE_CODING,\nGET_LINE_CODING,\nSET_CONTROL_LINE_STATE"];

    node  [shape=point, width=0.01, height=0.01, label=""];
    c1a [pos="0.40,5.15!"];
    c1b [pos="0.40,4.68!"];
    c2a [pos="0.85,4.43!"];
    c2b [pos="0.85,3.96!"];
    c3a [pos="1.30,3.66!"];
    c3b [pos="1.30,3.24!"];
    c4a [pos="1.30,3.66!"];
    c4b [pos="1.30,2.52!"];
    c5a [pos="0.85,4.43!"];
    c5b [pos="0.85,1.80!"];
    c6a [pos="1.30,1.55!"];
    c6b [pos="1.30,1.08!"];
    c7a [pos="1.30,1.55!"];
    c7b [pos="1.30,0.36!"];
    e0a [pos="6.05,5.4!"];

    c1a -> c1b [arrowhead=none];  c1b -> n1;
    c2a -> c2b [arrowhead=none];  c2b -> n2;
    c3a -> c3b [arrowhead=none];  c3b -> n3;
    c4a -> c4b [arrowhead=none];  c4b -> n4;
    c5a -> c5b [arrowhead=none];  c5b -> n5;
    c6a -> c6b [arrowhead=none];  c6b -> n6;
    c7a -> c7b [arrowhead=none];  c7b -> n7;
    n0 -> e0a [arrowhead=none, style=dashed];  e0a -> ep0 [style=dashed];
}
