// Packet buffers with automatic handshakes: two 64-byte buffers per bulk
// direction, so that the hardware fills or empties one while software
// works on the other, and an 8-byte buffer for SETUP.
//
// Fixed grid (positions in inches): USB hardware at x=1.0, buffers at
// x=3.4, processor at x=5.9.
//
// SPDX-License-Identifier: Apache-2.0

digraph buffers {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,3.5"];
    node  [shape=box, style="rounded,filled", fillcolor="#e2f0d9",
           fontname="Helvetica", fontsize=10, width=1.9, height=0.42,
           fixedsize=true];
    edge  [arrowsize=0.6, penwidth=1.3];

    hw   [pos="0.9,1.33!", width=1.3, height=2.95, label="Deserialiser,\nserialiser and\nautomatic\nhandshakes",
          fillcolor="#dbe8f5"];
    cpu  [pos="5.95,1.33!", width=1.3, height=2.95, label="RISC-V\nprocessor",
          fillcolor="#fbe5d6"];

    oa [pos="3.4,2.5!", label="bulk OUT buffer A, 64 bytes"];
    ob [pos="3.4,2.0!", label="bulk OUT buffer B, 64 bytes", fillcolor="#ffffff"];
    ia [pos="3.4,1.3!", label="bulk IN buffer A, 64 bytes"];
    ib [pos="3.4,0.8!", label="bulk IN buffer B, 64 bytes", fillcolor="#ffffff"];
    su [pos="3.4,0.1!", label="SETUP buffer, 8 bytes"];

    node [shape=plaintext, style="", fontsize=10, width=1.6, height=0.2];
    l1 [pos="3.4,3.0!", width=3.6, label="green: in use by the hardware; white: by software"];

    node [shape=point, width=0.01, height=0.01, label=""];
    a1 [pos="1.55,2.5!"];  b2 [pos="5.3,2.0!"];
    a3 [pos="1.55,1.3!"];  b4 [pos="5.3,0.8!"];
    a5 [pos="1.55,0.1!"];  b5 [pos="5.3,0.1!"];

    a1 -> oa;  ob -> b2;
    ia -> a3;  b4 -> ib;
    a5 -> su;  su -> b5;
}
