// The three kinds of source pull-up (Rp), each forming a divider with the
// sink's pull-down (Rd) on the CC wire. Values from Type-C Table 4-27 and
// Table 4-28, as quoted on resistor-advertisement.rst.
//
// Fixed grid (positions in inches):
//   x=1.1, 3.45, 5.8   the three kinds of Rp
//   y=3.6 supply, 2.8 Rp, 2.0 CC wire, 1.15 Rd, 0.5 ground
//
// SPDX-License-Identifier: Apache-2.0

graph rp_divider {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=1.9, height=0.5,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=10];

    src [label="Source", labelloc=t, fontsize=12, pos="3.45,3.25!",
         width=6.9, height=1.6, style="rounded,dashed", fillcolor="none",
         color="#c55a11", fontcolor="#c55a11"];
    snk [label="Sink", labelloc=b, fontsize=12, pos="3.45,0.7!",
         width=6.9, height=1.6, style="rounded,dashed", fillcolor="none",
         color="#548235", fontcolor="#548235"];

    s1 [pos="1.1,3.55!", label="5 V supply\n(4.75 to 5.5 V)", height=0.48,
        fillcolor="#ffffff"];
    s2 [pos="3.45,3.55!", label="3.3 V supply\n(3.135 to 3.465 V)",
        height=0.48, fillcolor="#ffffff"];
    s3 [pos="5.8,3.55!", label="Supply\n(1.7 to 5.5 V)", height=0.48,
        fillcolor="#ffffff"];

    r1 [pos="1.1,2.8!", label="Rp resistor\n56, 22 or 10 kΩ",
        fillcolor="#fbe5d6"];
    r2 [pos="3.45,2.8!", label="Rp resistor\n36, 12 or 4.7 kΩ",
        fillcolor="#fbe5d6"];
    r3 [pos="5.8,2.8!", label="Rp current source\n80, 180 or 330 µA",
        fillcolor="#fbe5d6"];

    j1 [pos="1.1,2.0!", shape=point, width=0.09, label="", style=filled, fillcolor="#000000"];
    j2 [pos="3.45,2.0!", shape=point, width=0.09, label="", style=filled, fillcolor="#000000"];
    j3 [pos="5.8,2.0!", shape=point, width=0.09, label="", style=filled, fillcolor="#000000"];
    v1 [pos="1.75,2.0!", shape=plaintext, style="", width=1.0, height=0.3,
        label="V_CC"];
    v2 [pos="4.1,2.0!", shape=plaintext, style="", width=1.0, height=0.3,
        label="V_CC"];
    v3 [pos="6.45,2.0!", shape=plaintext, style="", width=1.0, height=0.3,
        label="V_CC"];

    d1 [pos="1.1,1.1!", label="Rd 5.1 kΩ", fillcolor="#e2f0d9"];
    d2 [pos="3.45,1.1!", label="Rd 5.1 kΩ", fillcolor="#e2f0d9"];
    d3 [pos="5.8,1.1!", label="Rd 5.1 kΩ", fillcolor="#e2f0d9"];

    g1 [pos="1.1,0.45!", label="GND", width=0.7, height=0.3,
        fillcolor="#ffffff"];
    g2 [pos="3.45,0.45!", label="GND", width=0.7, height=0.3,
        fillcolor="#ffffff"];
    g3 [pos="5.8,0.45!", label="GND", width=0.7, height=0.3,
        fillcolor="#ffffff"];

    lev [pos="3.45,-0.4!", shape=plaintext, style="", width=6.9,
         height=0.35, fontsize=11,
         label="V_CC for the default, 1.5 A and 3.0 A levels: about 0.4 V, 0.9 V and 1.7 V"];

    s1 -- r1; s2 -- r2; s3 -- r3;
    r1 -- j1; r2 -- j2; r3 -- j3;
    j1 -- d1 [penwidth=2.5, color="#2e75b6", label="  CC wire"];
    j2 -- d2 [penwidth=2.5, color="#2e75b6", label="  CC wire"];
    j3 -- d3 [penwidth=2.5, color="#2e75b6", label="  CC wire"];
    d1 -- g1; d2 -- g2; d3 -- g3;
}
