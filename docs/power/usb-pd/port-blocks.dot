// Circuits for one dual-role USB Type-C port controlled by software on the
// evampire RISC-V core, with the minimum dedicated hardware. Blocks marked
// "on chip or board" are an open placement decision.
//
// SPDX-License-Identifier: Apache-2.0

digraph port_blocks {
    graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.18,
           ranksep=0.35, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=9, width=1.25];
    edge  [fontname="Helvetica", fontsize=8, arrowsize=0.6];

    subgraph cluster_edge {
        label="Connector side\n(on chip or board)"; style="rounded,dashed"; color="#888888";
        prot    [label="CC protection\n(blocks a VBUS\nshort)", fillcolor="#ffffff"];
        div     [label="VBUS divider\nand discharge", fillcolor="#ffffff"];
        snksw   [label="Sink switch\n(reverse\nblocking)", fillcolor="#ffffff"];
        srcconv [label="Source\nconverter", fillcolor="#ffffff"];
    }

    subgraph cluster_analog {
        label="CC front end, per CC pin"; style="rounded"; color="#ed7d31";
        rp    [label="Rp current\nsources", fillcolor="#fbe5d6"];
        rd    [label="Rd and\ndead-battery Rd", fillcolor="#fbe5d6"];
        vsw   [label="VCONN switch,\ncurrent limit", fillcolor="#fbe5d6"];
        cmp   [label="Comparators\n(levels, BMC,\nFRS)", fillcolor="#fbe5d6"];
        drv   [label="BMC driver\n1.125 V, slew\nlimited", fillcolor="#fbe5d6"];
    }

    subgraph cluster_digital {
        label="Generic digital"; style="rounded"; color="#5b9bd5";
        gpio [label="Input and\noutput bits", fillcolor="#dbe8f5"];
        tmr  [label="Timer capture\nand compare", fillcolor="#dbe8f5"];
        cpu  [label="RISC-V core\n(all protocol\nwork)", fillcolor="#e2f0d9"];
    }

    { rank=same; prot; div; snksw; srcconv; }
    { rank=same; rp; rd; vsw; cmp; drv; }
    { rank=same; gpio; tmr; }

    rp -> rd -> vsw -> cmp -> drv [style=invis];
    prot -> div -> snksw -> srcconv [style=invis];

    prot -> rp [dir=back];
    prot -> rd [dir=both];
    prot -> vsw [dir=back];
    prot -> cmp;
    prot -> drv [dir=back];

    rp -> gpio [dir=back, style=dashed];
    rd -> gpio [dir=back, style=dashed];
    vsw -> gpio [dir=back, style=dashed];
    cmp -> tmr;
    cmp -> gpio;
    drv -> tmr [dir=back];

    gpio -> cpu [dir=both];
    tmr -> cpu [dir=both];
}
