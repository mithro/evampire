// The plain input and output bits between one port's analogue front end
// and the processor in the software-only design (software.rst).
//
// Fixed grid (positions in inches): front-end blocks at x=0.9, bits at
// x=3.35, processor at x=5.75.
//
// SPDX-License-Identifier: Apache-2.0

digraph register_bits {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10, width=1.45, height=0.42,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    rp  [pos="0.9,3.0!", label="Rp current sources"];
    rd  [pos="0.9,2.45!", label="Rd"];
    vc  [pos="0.9,1.9!", label="VCONN switches"];
    drv [pos="0.9,1.35!", label="BMC driver"];
    cmp [pos="0.9,0.6!", label="comparators"];

    b1  [pos="3.35,3.0!", label="Rp level, enable", width=1.95,
         fillcolor="#dbe8f5"];
    b2  [pos="3.35,2.45!", label="Rd enable", width=1.95, fillcolor="#dbe8f5"];
    b3  [pos="3.35,1.9!", label="VCONN enable, per CC pin", width=1.95,
         fillcolor="#dbe8f5"];
    b4  [pos="3.35,1.35!", label="driver enable, data", width=1.95,
         fillcolor="#dbe8f5"];
    b5  [pos="3.35,0.85!", label="threshold select", width=1.95,
         fillcolor="#dbe8f5"];
    b6  [pos="3.35,0.35!", label="comparator outputs", width=1.95,
         fillcolor="#e2f0d9"];

    reg [pos="3.35,1.75!", label="input and output bits", labelloc=t,
         width=2.2, height=3.45, style="rounded,dashed", fillcolor="none",
         fontsize=10];
    cpu [pos="5.75,1.7!", label="processor:\nBMC, 4b5b, CRC-32,\nGoodCRC, timers,\nstate machines,\nprotocol",
         width=1.5, height=2.9, fillcolor="#fbe5d6"];

    b1 -> rp; b2 -> rd; b3 -> vc; b4 -> drv; b5 -> cmp; cmp -> b6;
    reg -> cpu [dir=both];
}
