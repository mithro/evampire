// Simplified USB Type-C connection state machine for a dual-role port
// with the Try.SRC preference (USB Type-C specification, section 4.5.2.2 and figure 4-16).
// Accessory and debug states are left out.
//
// SPDX-License-Identifier: Apache-2.0

digraph drp_states {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.3,
           ranksep=0.45, newrank=true];
    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=10, width=1.3];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    usnk [label="Unattached.SNK\n(Rd)", fillcolor="#e2f0d9"];
    usrc [label="Unattached.SRC\n(Rp)", fillcolor="#fbe5d6"];
    awsnk [label="AttachWait.SNK\n(Rd)", fillcolor="#e2f0d9"];
    awsrc [label="AttachWait.SRC\n(Rp, VBUS off)", fillcolor="#fbe5d6"];
    trysrc [label="Try.SRC\n(Rp, VBUS off)", fillcolor="#fbe5d6"];
    twsnk [label="TryWait.SNK\n(Rd)", fillcolor="#e2f0d9"];
    asnk [label="Attached.SNK\n(Rd, VBUS in)", fillcolor="#c5e0b4", penwidth=2];
    asrc [label="Attached.SRC\n(Rp, VBUS out)", fillcolor="#f8cbad", penwidth=2];
    err  [label="ErrorRecovery\n(CC open)", fillcolor="#f2f2f2"];

    { rank=same; usrc; usnk; err; }
    { rank=same; awsrc; awsnk; }
    { rank=same; trysrc; twsnk; }
    { rank=same; asrc; asnk; }

    // Left to right order within each row: source states on the left.
    usrc -> usnk -> err [style=invis];
    awsrc -> awsnk [style=invis];
    trysrc -> twsnk [style=invis];
    asrc -> asnk [style=invis];
    awsrc -> trysrc [style=invis, weight=5];
    awsnk -> twsnk [style=invis, weight=5];

    usnk -> usrc [label="toggle"];
    usrc -> usnk [label="toggle"];
    usnk -> err [style=dotted, dir=back];
    usnk -> awsnk [label="Rp seen"];
    usrc -> awsrc [label="Rd seen"];
    awsnk -> asnk [label="Rp stable,\nVBUS on"];
    awsnk -> trysrc [label="same, prefers\nsource"];
    awsrc -> asrc [label="Rd stable,\nVBUS at 0 V"];
    trysrc -> asrc [label="Rd seen"];
    trysrc -> twsnk [label="no Rd"];
    twsnk -> asnk [label="VBUS on"];
    asnk -> asrc [label="PR_Swap", style=dashed, dir=both, constraint=false];
}
