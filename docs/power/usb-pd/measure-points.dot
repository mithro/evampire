// What evampire measures and limits on one USB Type-C port and on the
// board's power bus (monitoring.rst).
//
// Fixed grid (positions in inches): power path at y=2.2 from the bus at
// x=0.6 to the connector at x=5.2; sensing at y=1.25; limits and the
// processor at y=0.45.
//
// SPDX-License-Identifier: Apache-2.0

digraph measure_points {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10, width=1.3, height=0.55,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    bus [pos="0.6,2.2!", label="board\npower bus", width=1.0,
         style="rounded,filled,bold", fillcolor="#dbe8f5"];
    isn [pos="2.15,2.2!", label="VBUS current sense,\nboth directions",
         width=1.5];
    sw  [pos="3.75,2.2!", label="power switch\nor converter"];
    con [pos="5.3,2.2!", label="USB Type-C\nconnector", width=1.1,
         fillcolor="#ffffff"];
    vs  [pos="5.3,1.25!", label="VBUS voltage\nsense", width=1.1];
    bs  [pos="0.6,1.25!", label="bus voltage\nand current", width=1.0];
    cpu [pos="1.5,0.4!", label="processor", width=1.0];
    lim [pos="4.35,0.4!", label="limit comparators,\nthresholds set by software",
         width=2.0];

    bus -> isn [dir=both, penwidth=2]; isn -> sw [dir=both, penwidth=2];
    sw -> con [dir=both, penwidth=2];
    con -> vs; isn -> lim; vs -> lim; bus -> bs; bs -> cpu;
    lim -> sw [style=dashed, label="switch off"];
    cpu -> lim [dir=both];
    ll [pos="2.75,0.58!", shape=plaintext, style="", width=1.3, height=0.3,
        fontsize=9, label="limits; interrupt\nand cause"];
}
