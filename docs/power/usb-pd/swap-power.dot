// Power flow on a board built around evampire before, during and after a
// power role swap from sink to source (role-changes.rst).
//
// Fixed grid (positions in inches): one panel per column at x=1.1, 3.4
// and 5.7; y=2.5 Power over Ethernet input, 1.5 board bus, 0.5 USB port.
//
// SPDX-License-Identifier: Apache-2.0

digraph swap_power {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10, width=1.8, height=0.5,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.8, penwidth=2.5];

    node [shape=plaintext, style="", height=0.3, fontsize=12];
    t1 [pos="1.1,3.2!", label="Before: sink"];
    t2 [pos="3.4,3.2!", label="During the swap"];
    t3 [pos="5.7,3.2!", label="After: source"];

    node [shape=box, style="rounded,filled,dashed", fillcolor="#ffffff",
          height=0.5, fontsize=10];
    e1 [pos="1.1,2.5!", label="Power over\nEthernet input"];
    e2 [pos="3.4,2.5!", label="Power over\nEthernet input"];
    e3 [pos="5.7,2.5!", label="Power over\nEthernet input"];

    node [style="rounded,filled,bold", fillcolor="#dbe8f5"];
    b1 [pos="1.1,1.5!", label="board power bus"];
    b2 [pos="3.4,1.5!", label="board power bus"];
    b3 [pos="5.7,1.5!", label="board power bus"];

    node [style="rounded,filled"];
    u1 [pos="1.1,0.5!", label="USB port: sink\n(partner supplies VBUS)",
        fillcolor="#e2f0d9"];
    u2 [pos="3.4,0.5!", label="USB port: at most\n2.5 mA from VBUS"];
    u3 [pos="5.7,0.5!", label="USB port: source\n(evampire supplies VBUS)",
        fillcolor="#fbe5d6"];

    e1 -> b1; u1 -> b1;
    e2 -> b2; u2 -> b2 [penwidth=1, style=dashed];
    e3 -> b3; b3 -> u3;
}
