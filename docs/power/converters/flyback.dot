// Flyback converter: the inverting buck-boost converter with a second
// winding on its inductor, so that the output is isolated from the input.
//
// Fixed grid (positions in inches): primary side left of the isolation
// barrier at x=3.1, secondary side right of it. Top wires at y=2.3,
// grounds at y=0.1. The dots mark the winding ends of the same polarity.
//
// SPDX-License-Identifier: Apache-2.0

graph flyback {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,4"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=1.0, height=0.5,
           fixedsize=true];
    edge  [penwidth=1.5];

    vin   [pos="0.5,1.2!", shape=circle, width=0.75, label="Input\n37–57 V",
           fillcolor="#ffffff"];
    np    [pos="2.6,1.65!", width=0.85, height=0.8, label="Np\nprimary",
           fillcolor="#dbe8f5"];
    sw    [pos="2.6,0.6!", width=0.85, height=0.55,
           label="Switch\n≥ 105 V", fillcolor="#fbe5d6"];
    ns    [pos="3.6,1.65!", width=0.85, height=0.8, label="Ns\nsecondary",
           fillcolor="#dbe8f5"];
    d     [pos="4.9,2.3!", width=0.9, label="Rectifier", fillcolor="#fbe5d6"];
    c     [pos="5.9,1.2!", width=0.75, label="C", fillcolor="#dbe8f5"];
    load  [pos="6.85,1.2!", width=0.75, label="Load", fillcolor="#ffffff"];

    // Text labels.
    node  [shape=plaintext, style="", fontsize=10, width=0.9, height=0.2];
    dot_p [pos="2.08,2.0!", width=0.15, fontsize=14, label="●"];
    dot_s [pos="4.12,1.3!", width=0.15, fontsize=14, label="●"];
    tr_l  [pos="3.1,2.95!", width=2.6, label="transformer, Np / Ns = 4"];
    bar_l [pos="3.1,2.72!", width=1.4, fontcolor="#c0392b",
           label="isolation barrier"];
    out_l [pos="6.4,2.5!", width=1.0, label="12 V output"];
    gp_l  [pos="1.45,-0.12!", width=1.4, label="primary ground"];
    gs_l  [pos="5.3,-0.12!", width=1.6, label="secondary ground"];
    dc_l  [pos="1.0,2.55!", width=1.8, label="D = 0.565 at 37 V,\n0.457 at 57 V",
           height=0.35];

    // Isolation barrier.
    node  [shape=point, width=0.01, height=0.01, label="", style=invis];
    b0    [pos="3.1,2.55!"];
    b1    [pos="3.1,-0.25!"];
    b0 -- b1 [style=dashed, color="#c0392b", penwidth=1.5];

    // Junctions and corners.
    node  [shape=point, width=0.06, height=0.06, label="", style=filled,
           fillcolor=black];
    in_t  [pos="0.5,2.3!"];
    p_t   [pos="2.6,2.3!"];
    pg    [pos="2.6,0.1!"];
    g0    [pos="0.5,0.1!"];
    s_t   [pos="3.6,2.3!"];
    s_b   [pos="3.6,0.1!"];
    out   [pos="5.9,2.3!", width=0.09, height=0.09];
    out_t [pos="6.85,2.3!"];
    g2    [pos="5.9,0.1!", width=0.09, height=0.09];
    g3    [pos="6.85,0.1!"];

    vin -- in_t;  in_t -- p_t;  p_t -- np;  np -- sw;  sw -- pg;
    pg -- g0;  g0 -- vin;
    s_t -- ns;  ns -- s_b;  s_t -- d;  d -- out;  out -- out_t;
    out -- c;  out_t -- load;  c -- g2;  load -- g3;  s_b -- g2;  g2 -- g3;
}
