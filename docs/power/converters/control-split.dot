// First-version converter control: evampire generates the switching
// signals and senses current and voltage; the gate drivers and the power
// stage are external parts.
//
// Fixed grid (positions in inches): column 1 (x=0.75) processor, column 2
// (x=2.85) control hardware on evampire, column 3 (x=5.1) gate driver and
// sensing, column 4 (x=6.75) power stage. Edge labels are separate text
// nodes placed beside the edges.
//
// SPDX-License-Identifier: Apache-2.0

digraph control_split {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,5", outputorder=nodesfirst];
    node  [shape=box, style="rounded,filled", fillcolor="#fbe5d6",
           fontname="Helvetica", fontsize=11, width=1.7, height=0.7,
           fixedsize=true];
    edge  [arrowsize=0.8];

    chip   [pos="1.95,2.0!", width=3.75, height=4.0, label="evampire",
            labelloc=t, style="rounded,bold", color="#1f4e79",
            fontcolor="#1f4e79", fillcolor="none", fontsize=13];

    cpu    [pos="0.75,2.0!", width=1.15, label="RISC-V\nsoftware"];
    pwm    [pos="2.85,3.3!", label="PWM generator\nand dead time"];
    cmp    [pos="2.85,2.0!", label="Comparators\n(peak current,\nshort circuit)"];
    adc    [pos="2.85,0.7!", label="ADC and DAC\n(monitoring,\nreferences)"];

    drv    [pos="5.1,3.3!", width=1.25, label="Gate driver\n(external)",
            fillcolor="#ffffff", style="rounded,filled,dashed"];
    stage  [pos="6.75,3.3!", width=1.25, label="Switches and\ninductor\n(external)",
            fillcolor="#ffffff", style="rounded,filled,dashed", height=0.75];
    sense  [pos="6.75,1.35!", width=1.25, height=0.75,
            label="Sense resistor\nand divider\n(external)",
            fillcolor="#ffffff", style="rounded,filled,dashed"];

    // Edge labels.
    node   [shape=plaintext, style="", fontsize=10, width=0.8, height=0.35];
    l_set  [pos="1.45,2.95!", label="settings"];
    l_lim  [pos="1.6,1.75!", label="limits,\nfaults"];
    l_rd   [pos="1.4,1.05!", label="readings"];
    l_pwm  [pos="4.1,3.5!", label="PWM"];
    l_gate [pos="5.95,3.5!", label="gate"];
    l_cur  [pos="4.9,1.95!", label="current"];
    l_cv   [pos="4.9,0.75!", label="current,\nvoltage"];
    l_end  [pos="3.35,2.65!", label="end pulse,\nstop"];
    l_pow  [pos="7.25,2.3!", label="power", width=0.5];

    cpu   -> pwm;
    cpu   -> cmp   [dir=both];
    adc   -> cpu;
    pwm   -> drv;
    drv   -> stage;
    stage -> sense [penwidth=2.5];
    sense -> cmp;
    sense -> adc;
    cmp   -> pwm;
}
