// Sense points around a power sourcing equipment output, and what each
// feeds on evampire: comparators for control and protection, an ADC for
// monitoring.
//
// Fixed grid (positions in inches): row 1 (y=3.4) the power path, row 2
// (y=2.2) the sense points, row 3 (y=0.75) the circuits on evampire.
// Edge colours: orange for control, red for protection, blue for
// monitoring.
//
// SPDX-License-Identifier: Apache-2.0

digraph sensing {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,5", outputorder=nodesfirst];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=1.3, height=0.6,
           fixedsize=true];
    edge  [arrowsize=0.7, penwidth=1.5];

    chip  [pos="3.85,0.75!", width=7.4, height=1.15, label="evampire",
           labelloc=b, style="rounded,bold", color="#1f4e79",
           fontcolor="#1f4e79", fillcolor="none", fontsize=12];

    bus   [pos="0.75,3.4!", width=1.1, label="Power bus", fillcolor="#dbe8f5"];
    stage [pos="2.35,3.4!", width=1.5, label="Boost power stage\n(S1, S2, L)",
           fillcolor="#fbe5d6"];
    cap   [pos="3.95,3.4!", width=1.1, label="Output\ncapacitor", fillcolor="#dbe8f5"];
    pse   [pos="5.45,3.4!", width=1.3, label="Port switch", fillcolor="#fbe5d6"];
    port  [pos="7.0,3.4!", width=1.1, label="Ethernet\nport B", fillcolor="#ffffff",
           style="rounded,filled,dashed"];

    s_bus [pos="0.75,2.2!", width=1.1, label="Bus voltage\nand current",
           fillcolor="#ffffff"];
    s_il  [pos="2.35,2.2!", width=1.4, label="Inductor current\nsense resistor",
           fillcolor="#ffffff"];
    s_out [pos="3.95,2.2!", width=1.1, label="Output\ndivider", fillcolor="#ffffff"];
    s_pt  [pos="5.45,2.2!", width=1.3, label="Port current\nsense resistor",
           fillcolor="#ffffff"];

    cmp   [pos="1.55,0.85!", width=2.2, height=0.65,
           label="Comparators with DAC\nthresholds: peak current,\ncurrent limit",
           fillcolor="#fbe5d6"];
    adc   [pos="3.95,0.85!", width=1.6, height=0.65,
           label="ADC with averaging:\nmonitoring, 1 kHz\nor less", fillcolor="#dbe8f5"];
    pcmp  [pos="6.2,0.85!", width=1.9, height=0.65,
           label="Port short comparator\n(µs)", fillcolor="#f4cccc"];

    edge  [arrowhead=none, penwidth=2.5];
    bus -> stage;  stage -> cap;  cap -> pse;  pse -> port;
    edge  [penwidth=1.2, style=dashed, color="#777777"];
    bus -> s_bus;  stage -> s_il;  cap -> s_out;  pse -> s_pt;

    edge  [arrowhead=normal, style=solid, penwidth=1.6];
    s_il  -> cmp  [color="#c55a11"];
    s_out -> cmp  [color="#c55a11"];
    s_bus -> adc  [color="#1f4e79"];
    s_out -> adc  [color="#1f4e79"];
    s_pt  -> adc  [color="#1f4e79"];
    s_pt  -> pcmp [color="#c0392b"];

    // Legend.
    node  [shape=plaintext, style="", fontsize=10, width=1.2, height=0.2];
    k1 [pos="1.0,4.0!", fontcolor="#c55a11", label="control and limit"];
    k2 [pos="3.3,4.0!", fontcolor="#1f4e79", label="monitoring"];
    k3 [pos="5.5,4.0!", fontcolor="#c0392b", label="port protection"];
}
