// Idealised waveforms of a synchronous buck converter, generated by
// waveforms.py (do not edit by hand). Duty cycle 0.25; the dead time is drawn
// larger than in a real converter so that it is visible.
//
// SPDX-License-Identifier: Apache-2.0

graph buck_waveforms {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,5"];
    node  [fontname="Helvetica", fontsize=11];
    edge  [penwidth=1.6];

    l_g1 [pos="0.7,3.825!", shape=plaintext, label="S1 gate", width=1.3, height=0.4];
    l_g2 [pos="0.7,3.075!", shape=plaintext, label="S2 gate", width=1.3, height=0.4];
    l_vsw [pos="0.7,2.325!", shape=plaintext, label="Switch node
voltage", width=1.3, height=0.4];
    l_il [pos="0.7,1.150!", shape=plaintext, label="Inductor
current", width=1.3, height=0.4];
    l_avg [pos="7.200,1.320!", shape=plaintext, label="average = Iout", width=1.2, height=0.2, fontsize=10];
    l_pk [pos="2.256,1.700!", shape=plaintext, label="peak", width=0.5, height=0.2, fontsize=10];
    l_vin [pos="1.903,2.700!", shape=plaintext, label="Vin", width=0.5, height=0.2, fontsize=10];
    l_ton [pos="1.903,4.200!", shape=plaintext, label="D × T", width=0.6, height=0.2, fontsize=10];
    l_t [pos="2.963,0.250!", shape=plaintext, label="one period T", width=1.2, height=0.2, fontsize=10];
    l_dt [pos="3.266,3.450!", shape=plaintext, label="S2 on (gaps at each end are the dead time)", width=3.0, height=0.2, fontsize=10];

    node  [shape=point, width=0.01, height=0.01, label=""];
    p1 [pos="1.550,3.600!"];
    p2 [pos="1.550,3.600!"];
    p3 [pos="1.550,4.050!"];
    p4 [pos="2.256,4.050!"];
    p5 [pos="2.256,3.600!"];
    p6 [pos="4.375,3.600!"];
    p7 [pos="4.375,4.050!"];
    p8 [pos="5.081,4.050!"];
    p9 [pos="5.081,3.600!"];
    p10 [pos="7.200,3.600!"];
    p11 [pos="1.550,2.850!"];
    p12 [pos="2.355,2.850!"];
    p13 [pos="2.355,3.300!"];
    p14 [pos="4.276,3.300!"];
    p15 [pos="4.276,2.850!"];
    p16 [pos="5.180,2.850!"];
    p17 [pos="5.180,3.300!"];
    p18 [pos="7.101,3.300!"];
    p19 [pos="7.101,2.850!"];
    p20 [pos="7.200,2.850!"];
    p21 [pos="1.550,2.100!"];
    p22 [pos="1.550,2.100!"];
    p23 [pos="1.550,2.550!"];
    p24 [pos="2.256,2.550!"];
    p25 [pos="2.256,2.100!"];
    p26 [pos="4.375,2.100!"];
    p27 [pos="4.375,2.550!"];
    p28 [pos="5.081,2.550!"];
    p29 [pos="5.081,2.100!"];
    p30 [pos="7.200,2.100!"];
    p31 [pos="1.550,0.750!"];
    p32 [pos="2.256,1.550!"];
    p33 [pos="4.375,0.750!"];
    p34 [pos="5.081,1.550!"];
    p35 [pos="7.200,0.750!"];
    p36 [pos="1.550,1.150!"];
    p37 [pos="7.200,1.150!"];
    p38 [pos="1.550,0.120!"];
    p39 [pos="4.375,0.120!"];

    p1 -- p2;
    p2 -- p3;
    p3 -- p4;
    p4 -- p5;
    p5 -- p6;
    p6 -- p7;
    p7 -- p8;
    p8 -- p9;
    p9 -- p10;
    p11 -- p12;
    p12 -- p13;
    p13 -- p14;
    p14 -- p15;
    p15 -- p16;
    p16 -- p17;
    p17 -- p18;
    p18 -- p19;
    p19 -- p20;
    p21 -- p22;
    p22 -- p23;
    p23 -- p24;
    p24 -- p25;
    p25 -- p26;
    p26 -- p27;
    p27 -- p28;
    p28 -- p29;
    p29 -- p30;
    p31 -- p32;
    p32 -- p33;
    p33 -- p34;
    p34 -- p35;
    p36 -- p37 [style=dashed, penwidth=1];
    p38 -- p39 [penwidth=1, dir=both, arrowsize=0.5];
}
