// SEPIC (positive output) and Cuk (negative output) converters, one above
// the other. Each has one switch, two inductors and a coupling capacitor.
//
// Fixed grid (positions in inches): panel (a) top row y=4.2, ground
// y=2.7; panel (b) top row y=1.7, ground y=0.2.
//
// SPDX-License-Identifier: Apache-2.0

digraph sepic_cuk {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,5.5"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10, width=0.8, height=0.45,
           fixedsize=true];
    edge  [penwidth=1.5, arrowhead=none];

    t_a [pos="3.6,4.75!", shape=plaintext, style="", width=6.0, height=0.2,
         fontsize=12, label="(a) SEPIC: positive output"];
    a_vin [pos="0.45,3.45!", shape=circle, width=0.65, label="Vin", fillcolor="#ffffff"];
    a_l1  [pos="1.45,4.2!", label="L1", fillcolor="#dbe8f5"];
    a_s   [pos="2.4,3.45!", width=1.05, label="switch:\nVin + Vout", fillcolor="#fbe5d6"];
    a_c1  [pos="3.35,4.2!", width=0.85, label="C1\ncoupling", fillcolor="#dbe8f5"];
    a_l2  [pos="4.3,3.45!", label="L2", fillcolor="#dbe8f5"];
    a_d   [pos="5.3,4.2!", width=1.1, label="diode:\nnode to output", fillcolor="#fbe5d6"];
    a_co  [pos="6.25,3.45!", width=0.55, label="C", fillcolor="#dbe8f5"];
    a_ld  [pos="7.0,3.45!", width=0.6, label="Load", fillcolor="#ffffff"];
    a_o   [pos="6.6,4.42!", shape=plaintext, style="", width=1.2, height=0.2,
           label="Vout, positive"];

    t_b [pos="3.6,2.25!", shape=plaintext, style="", width=6.0, height=0.2,
         fontsize=12, label="(b) Ćuk: negative output"];
    b_vin [pos="0.45,0.95!", shape=circle, width=0.65, label="Vin", fillcolor="#ffffff"];
    b_l1  [pos="1.45,1.7!", label="L1", fillcolor="#dbe8f5"];
    b_s   [pos="2.4,0.95!", width=1.05, label="switch:\nVin + |Vout|", fillcolor="#fbe5d6"];
    b_c1  [pos="3.35,1.7!", width=0.85, label="C1\ncoupling", fillcolor="#dbe8f5"];
    b_d   [pos="4.3,0.95!", width=1.1, label="diode: node\nto ground", fillcolor="#fbe5d6"];
    b_l2  [pos="5.3,1.7!", label="L2", fillcolor="#dbe8f5"];
    b_co  [pos="6.25,0.95!", width=0.55, label="C", fillcolor="#dbe8f5"];
    b_ld  [pos="7.0,0.95!", width=0.6, label="Load", fillcolor="#ffffff"];
    b_o   [pos="6.6,1.92!", shape=plaintext, style="", width=1.2, height=0.2,
           label="Vout, negative"];

    node  [shape=point, width=0.06, height=0.06, label="", style=filled,
           fillcolor=black];
    a_it [pos="0.45,4.2!"]; a_n1 [pos="2.4,4.2!", width=0.09];
    a_n2 [pos="4.3,4.2!", width=0.09]; a_out [pos="6.25,4.2!", width=0.09];
    a_ot [pos="7.0,4.2!"];
    a_g0 [pos="0.45,2.7!"]; a_g1 [pos="2.4,2.7!", width=0.09];
    a_g2 [pos="4.3,2.7!", width=0.09]; a_g3 [pos="6.25,2.7!", width=0.09];
    a_g4 [pos="7.0,2.7!"];
    b_it [pos="0.45,1.7!"]; b_n1 [pos="2.4,1.7!", width=0.09];
    b_n2 [pos="4.3,1.7!", width=0.09]; b_out [pos="6.25,1.7!", width=0.09];
    b_ot [pos="7.0,1.7!"];
    b_g0 [pos="0.45,0.2!"]; b_g1 [pos="2.4,0.2!", width=0.09];
    b_g2 [pos="4.3,0.2!", width=0.09]; b_g3 [pos="6.25,0.2!", width=0.09];
    b_g4 [pos="7.0,0.2!"];

    a_vin -> a_it -> a_l1 -> a_n1 -> a_c1 -> a_n2 -> a_d -> a_out -> a_ot -> a_ld;
    a_n1 -> a_s -> a_g1;  a_n2 -> a_l2 -> a_g2;  a_out -> a_co -> a_g3;
    a_ld -> a_g4;  a_vin -> a_g0;  a_g0 -> a_g1 -> a_g2 -> a_g3 -> a_g4;

    b_vin -> b_it -> b_l1 -> b_n1 -> b_c1 -> b_n2 -> b_l2 -> b_out -> b_ot -> b_ld;
    b_n1 -> b_s -> b_g1;  b_n2 -> b_d -> b_g2;  b_out -> b_co -> b_g3;
    b_ld -> b_g4;  b_vin -> b_g0;  b_g0 -> b_g1 -> b_g2 -> b_g3 -> b_g4;
}
