// Arrangement with one bidirectional four-switch buck-boost converter
// between the Ethernet-side node and the USB Type-C port.
//
// Fixed grid (positions in inches): column 1 (x=1.25) Ethernet ports,
// column 2 (x=3.75) converter and board supplies, column 3 (x=6.35) USB.
// Edge labels are separate text nodes placed beside the edges.
//
// SPDX-License-Identifier: Apache-2.0

digraph shared {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,5"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=2.2, height=0.65,
           fixedsize=true];
    edge  [arrowsize=0.8, penwidth=2.5];

    port_a [pos="1.25,3.3!", label="Ethernet port A\npowered device front end",
            fillcolor="#ffffff", style="rounded,filled,dashed"];
    enode  [pos="1.25,1.9!", label="Ethernet-side node\n37 V to 57 V",
            fillcolor="#dbe8f5", style="rounded,filled,bold"];
    port_b [pos="1.25,0.5!", label="Ethernet port B\npower sourcing\nequipment switch",
            height=0.75, fillcolor="#ffffff", style="rounded,filled,dashed"];
    conv   [pos="3.85,1.9!", width=1.75, height=0.75,
            label="Bidirectional\nfour-switch\nbuck-boost", fillcolor="#fbe5d6"];
    supp   [pos="3.85,0.5!", width=1.75, label="Board supplies\n(evampire, others)"];
    usb    [pos="6.4,1.9!", width=1.6, height=0.75,
            label="USB Type-C port\n5 V to 48 V", fillcolor="#ffffff",
            style="rounded,filled,dashed"];

    // Edge labels.
    node   [shape=plaintext, style="", fontsize=10, width=0.9, height=0.35];
    l_in   [pos="1.62,2.6!", label="power in"];
    l_out  [pos="1.67,1.2!", label="power out"];
    l_bi1  [pos="2.66,2.25!", label="either\ndirection"];
    l_bi2  [pos="5.13,2.25!", label="either\ndirection"];

    port_a -> enode;
    enode  -> port_b;
    enode  -> conv   [dir=both];
    conv   -> usb    [dir=both];
    enode  -> supp;
}
