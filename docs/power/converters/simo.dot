// Single-inductor multiple-output converter: one inductor, switched to
// each output in turn.
//
// Fixed grid (positions in inches): the input half bridge on the left,
// the inductor in the middle, one output switch per output on the right.
//
// SPDX-License-Identifier: Apache-2.0

graph simo {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,3.5"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=0.9, height=0.45,
           fixedsize=true];
    edge  [penwidth=1.5];

    vin [pos="0.5,1.3!", shape=circle, width=0.7, label="Vin", fillcolor="#ffffff"];
    s1  [pos="1.6,2.2!", label="S1", fillcolor="#fbe5d6"];
    s2  [pos="2.5,1.3!", label="S2", fillcolor="#fbe5d6"];
    l   [pos="3.5,2.2!", label="L", fillcolor="#dbe8f5"];
    sa  [pos="5.0,2.9!", width=1.3, label="output switch A", fillcolor="#fbe5d6"];
    sb  [pos="5.0,1.5!", width=1.3, label="output switch B", fillcolor="#fbe5d6"];
    oa  [pos="6.7,2.9!", width=1.2, label="output 1\n(USB port 1)", height=0.5, fillcolor="#e2f0d9"];
    ob  [pos="6.7,1.5!", width=1.2, label="output 2\n(USB port 2)", height=0.5, fillcolor="#e2f0d9"];
    nt  [pos="4.6,0.55!", shape=plaintext, style="", width=4.5, height=0.35,
         fontsize=10, label="the inductor's energy goes to output 1 in one part\nof the period and to output 2 in another"];

    node [shape=point, width=0.07, height=0.07, label="", style=filled, fillcolor=black];
    it [pos="0.5,2.2!", width=0.01]; n1 [pos="2.5,2.2!"]; n2 [pos="4.2,2.2!"];
    ka [pos="4.2,2.9!", width=0.01]; kb [pos="4.2,1.5!", width=0.01];
    g0 [pos="0.5,0.9!", width=0.01]; g1 [pos="2.5,0.9!", width=0.01];

    vin -- it -- s1 -- n1 -- l -- n2;  n1 -- s2 -- g1;  vin -- g0 -- g1;
    n2 -- ka -- sa -- oa;  n2 -- kb -- sb -- ob;
}
