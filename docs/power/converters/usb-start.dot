// Start-up from vSafe5V on a USB Type-C port, for two arrangements.
//
// Fixed grid (positions in inches): panel (a) along y=2.6, panel (b) along
// y=1.1 with its alternative path along y=0.3.
//
// SPDX-License-Identifier: Apache-2.0

digraph usb_start {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,3.6"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10, width=1.45, height=0.55,
           fixedsize=true];
    edge  [penwidth=2, arrowsize=0.7];

    t_a [pos="3.6,3.15!", shape=plaintext, style="", width=6.5, height=0.2,
         fontsize=11, label="(a) Three separate converters: the bus follows VBUS"];
    a_v [pos="0.8,2.6!", label="VBUS, vSafe5V\n4.75 V to 5.5 V", fillcolor="#ffffff",
         style="rounded,filled,dashed"];
    a_s [pos="2.75,2.6!", label="VBUS switch", fillcolor="#e2f0d9"];
    a_b [pos="4.7,2.6!", label="power bus\nat about 5 V", fillcolor="#dbe8f5"];
    a_p [pos="6.65,2.6!", label="board supplies\nand evampire", fillcolor="#fbe5d6"];

    t_b [pos="3.6,1.65!", shape=plaintext, style="", width=6.5, height=0.2,
         fontsize=11, label="(b) High bus: the USB converter raises the bus, or VBUS feeds the supplies"];
    b_v [pos="0.8,1.1!", label="VBUS, vSafe5V\n4.75 V to 5.5 V", fillcolor="#ffffff",
         style="rounded,filled,dashed"];
    b_c [pos="2.75,1.1!", label="USB converter,\nhardware default", fillcolor="#fbe5d6"];
    b_b [pos="4.7,1.1!", label="power bus\n37 V to 57 V", fillcolor="#dbe8f5"];
    b_p [pos="6.65,1.1!", label="board supplies\nand evampire", fillcolor="#fbe5d6"];
    n   [pos="3.6,-0.25!", shape=plaintext, style="", width=6.5, height=0.2,
         fontsize=10, label="available before negotiation: 2.375 W to 14.25 W"];

    node [shape=point, width=0.01, height=0.01, label=""];
    k1 [pos="0.8,0.3!"];  k2 [pos="6.65,0.3!"];

    a_v -> a_s -> a_b -> a_p;
    b_v -> b_c -> b_b -> b_p;
    b_v -> k1 [arrowhead=none, style=dashed, penwidth=1.3];
    k1 -> k2 [arrowhead=none, style=dashed, penwidth=1.3];
    k2 -> b_p [style=dashed, penwidth=1.3];
}
