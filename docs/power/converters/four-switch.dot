// Four-switch non-inverting buck-boost converter power stage: a buck half
// bridge (S1, S2) and a boost half bridge (S3, S4) sharing one inductor.
//
// Fixed grid (positions in inches): the top row (y=2.0) carries the input,
// the inductor and the output, the bottom row (y=0.2) is ground.
//
// SPDX-License-Identifier: Apache-2.0

graph four_switch {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,4"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=0.8, height=0.5,
           fixedsize=true];
    edge  [penwidth=1.5];

    vin   [pos="0.45,1.1!", shape=circle, width=0.75, label="Input\nVin",
           fillcolor="#ffffff"];
    s1    [pos="1.45,2.0!", label="S1", fillcolor="#fbe5d6"];
    s2    [pos="2.4,1.1!", label="S2", fillcolor="#fbe5d6"];
    l     [pos="3.55,2.0!", width=0.9, label="L\ninductor", fillcolor="#dbe8f5"];
    s3    [pos="4.7,1.1!", label="S3", fillcolor="#fbe5d6"];
    s4    [pos="5.65,2.0!", label="S4", fillcolor="#fbe5d6"];
    c     [pos="6.5,1.1!", width=0.75, label="C", fillcolor="#dbe8f5"];
    load  [pos="7.25,1.1!", width=0.6, label="Load", fillcolor="#ffffff"];

    // Text labels.
    a_l   [pos="2.4,2.22!", shape=plaintext, style="", label="node A",
           width=0.7, height=0.2];
    b_l   [pos="4.7,2.22!", shape=plaintext, style="", label="node B",
           width=0.7, height=0.2];
    out_l [pos="6.875,2.22!", shape=plaintext, style="", label="Vout",
           width=0.5, height=0.2];
    buck_l  [pos="1.4,0.42!", shape=plaintext, style="",
             label="buck half bridge", width=1.4, height=0.2];
    boost_l [pos="5.6,0.42!", shape=plaintext, style="",
             label="boost half bridge", width=1.4, height=0.2];

    // Junctions and corners.
    node  [shape=point, width=0.06, height=0.06, label="", style=filled,
           fillcolor=black];
    in_t  [pos="0.45,2.0!"];
    na    [pos="2.4,2.0!", width=0.09, height=0.09];
    nb    [pos="4.7,2.0!", width=0.09, height=0.09];
    out   [pos="6.5,2.0!", width=0.09, height=0.09];
    out_t [pos="7.25,2.0!"];
    g0    [pos="0.45,0.2!"];
    g1    [pos="2.4,0.2!", width=0.09, height=0.09];
    g2    [pos="4.7,0.2!", width=0.09, height=0.09];
    g3    [pos="6.5,0.2!", width=0.09, height=0.09];
    g4    [pos="7.25,0.2!"];

    vin -- in_t;  in_t -- s1;  s1 -- na;  na -- l;  l -- nb;  nb -- s4;
    s4 -- out;  out -- out_t;  out_t -- load;  out -- c;
    na -- s2;  nb -- s3;
    vin -- g0;  s2 -- g1;  s3 -- g2;  c -- g3;  load -- g4;
    g0 -- g1 -- g2 -- g3 -- g4;
}
