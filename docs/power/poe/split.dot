// Recommended split of Power over Ethernet functions between external
// parts and evampire, for both port roles. Bold arrows: power. Dashed
// arrows: status and control.
//
// SPDX-License-Identifier: Apache-2.0

digraph poe_split {
    graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.3,
           ranksep=0.55, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    subgraph cluster_pd {
        label="External, port A (powered device), 37–57 V";
        labelloc="b"; style="rounded,dashed"; color="#c55a11";
        bridges [label="Input bridges\nand surge clamp", fillcolor="#fbe5d6"];
        pdc     [label="Powered-device\ncontroller chip", fillcolor="#fbe5d6"];
        conv    [label="Input converter", fillcolor="#fbe5d6"];
    }

    subgraph cluster_pse {
        label="External, port B (power sourcing equipment), 44–57 V";
        labelloc="b"; style="rounded,dashed"; color="#c55a11";
        boost [label="Boost converter\nto 54 V", fillcolor="#fbe5d6"];
        psec  [label="PSE controller chip,\nMOSFETs, sense\nresistors, port TVS", fillcolor="#fbe5d6"];
    }

    div [label="Resistor dividers\n(optional)", fillcolor="#ffffff"];
    opto [label="Optocouplers or\npull-ups", fillcolor="#ffffff"];

    subgraph cluster_chip {
        label="evampire (3.3 V devices)"; labelloc="b"; style="rounded,bold";
        color="#1f4e79";
        gpio [label="Status inputs and\nenable outputs", fillcolor="#dbe8f5"];
        i2c  [label="I2C controller\n(open decision)", fillcolor="#dbe8f5"];
        adc  [label="Comparator or ADC\n(open decision)", fillcolor="#dbe8f5"];
        cpu  [label="RISC-V software:\npower budget,\nLLDP on both ports", fillcolor="#dbe8f5"];
    }

    bridges -> pdc   [penwidth=2.5];
    pdc     -> conv  [penwidth=2.5];
    conv    -> boost [penwidth=2.5, label="bus"];
    boost   -> psec  [penwidth=2.5];

    pdc  -> opto [style=dashed];
    opto -> gpio [style=dashed];
    psec -> i2c  [style=dashed, dir=both];
    conv -> div  [style=dashed];
    boost -> div [style=dashed];
    div  -> adc  [style=dashed, label="0–3 V"];
    gpio -> cpu;
    i2c  -> cpu;
    adc  -> cpu;
}
