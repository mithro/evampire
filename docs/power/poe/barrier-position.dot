// The two places the isolation barrier can sit on a board built around
// evampire. From isolation.rst.
//
// Fill colours: cable side #fbe5d6, evampire #dbe8f5, isolating parts
// #fff2cc, other connectors #ffffff. The dashed red line is the barrier.
// Bold edges carry power, thin edges signals.
// Fixed grid (positions in inches): left panel x=0-3.4, right x=3.8-7.2.
//
// SPDX-License-Identifier: Apache-2.0

graph barrier_position {
    graph [layout=neato, splines=false, overlap=true, outputorder=edgesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=11, width=1.3, height=0.5, fixedsize=true];
    edge  [fontname="Helvetica", fontsize=10];

    t1 [pos="1.7,4.1!", shape=plaintext, style="", width=3.4, fontsize=12,
        label="Barrier between evampire and the cable"];
    t2 [pos="5.5,4.1!", shape=plaintext, style="", width=3.3, fontsize=12,
        label="Barrier at the other connectors"];

    // Left panel.
    c1  [pos="0.9,3.3!", label="Cable-side\ncircuits", fillcolor="#fbe5d6"];
    iso [pos="0.9,2.2!", label="Isolated converter\nand signal links",
         fillcolor="#fff2cc", width=1.5];
    e1  [pos="0.9,1.1!", label="evampire", fillcolor="#dbe8f5"];
    u1  [pos="2.75,1.1!", label="USB-C and other\nconnectors", fillcolor="#ffffff",
         width=1.3];
    g1  [pos="1.83,1.38!", shape=plaintext, style="", width=0.6, height=0.3,
         fontsize=10, label="shared\nground"];
    p1  [pos="0.05,2.2!", shape=point, width=0.01];
    q1  [pos="3.4,2.2!", shape=point, width=0.01];
    bl1 [pos="2.7,2.38!", shape=plaintext, style="", width=0.8, height=0.2,
         fontsize=10, fontcolor="#c00000", label="barrier"];
    p1 -- q1 [style=dashed, color="#c00000", penwidth=1.5];
    c1 -- iso [penwidth=2.5];
    iso -- e1 [penwidth=2.5];
    e1 -- u1;

    // Right panel.
    c2  [pos="4.6,3.3!", label="Cable-side\ncircuits", fillcolor="#fbe5d6"];
    e2  [pos="4.6,2.2!", label="evampire,\non the cable side", fillcolor="#dbe8f5",
         width=1.5];
    iso2 [pos="6.4,1.65!", label="Isolation", fillcolor="#fff2cc", width=1.0];
    u2  [pos="6.4,0.8!", label="USB-C and other\nconnectors", fillcolor="#ffffff"];
    p2  [pos="3.85,1.65!", shape=point, width=0.01];
    q2  [pos="7.2,1.65!", shape=point, width=0.01];
    bl2 [pos="4.3,1.47!", shape=plaintext, style="", width=0.8, height=0.2,
         fontsize=10, fontcolor="#c00000", label="barrier"];
    p2 -- q2 [style=dashed, color="#c00000", penwidth=1.5];
    c2 -- e2 [penwidth=2.5];
    e2 -- iso2 [penwidth=2.5];
    iso2 -- u2 [penwidth=2.5];
    n2 [pos="5.5,0.05!", shape=plaintext, style="", width=3.6, height=0.4,
        fontsize=10, label="In Environment B this serves one Ethernet port\nonly: the two ports must be isolated from each other."];
}
