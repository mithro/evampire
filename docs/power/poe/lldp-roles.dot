// evampire in both LLDP roles: a powered device on port A and power
// sourcing equipment on port B. When the allocation on port A falls, the
// software lowers the allocation on port B first. Time runs from top to
// bottom; not to scale. From lldp.rst.
//
// SPDX-License-Identifier: Apache-2.0

digraph lldp_roles {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=1.2,
           ranksep=0.3, newrank=true, splines=false];
    node  [shape=point, width=0.05, color="#555555", fontname="Helvetica",
           fontsize=10];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    u [shape=box, style="rounded,filled", fillcolor="#fbe5d6",
       label="Upstream power\nsourcing equipment", width=1.4];
    e [shape=box, style="rounded,filled", fillcolor="#dbe8f5",
       label="evampire: PD on A,\nPSE on B", width=1.4];
    d [shape=box, style="rounded,filled", fillcolor="#e2f0d9",
       label="Downstream\npowered device", width=1.4];

    u1; u2; u3; u4;
    e1; e2; e3; e4;
    d1; d2; d3; d4;

    { rank=same; u; e; d; }
    { rank=same; u1; e1; d1; }
    { rank=same; u2; e2; d2; }
    { rank=same; u3; e3; d3; }
    { rank=same; u4; e4; d4; }

    edge [arrowhead=none, style=dashed, color="#999999", weight=100];
    u -> u1 -> u2 -> u3 -> u4;
    e -> e1 -> e2 -> e3 -> e4;
    d -> d1 -> d2 -> d3 -> d4;

    edge [arrowhead=normal, style=solid, color="#000000", weight=0];
    u1 -> e1 [label="port A: lower\nallocation"];
    e2 -> d2 [label="port B: lower\nallocation first"];
    d3 -> e3 [label="echo: in sync"];
    e4 -> u4 [label="echo: draw within\nthe new allocation"];
}
