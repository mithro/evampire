// The connection check of power sourcing equipment that powers both pair
// sets: a single-signature powered device against a dual-signature one.
// Values from power-sourcing.rst (IEEE 802.3 145.2.7 and 145.3.5).
//
// Fill colours: far-end equipment #fbe5d6, power circuits #fff2cc,
// outcomes #e2f0d9 (valid) and #f4cccc (invalid).
// Fixed grid (positions in inches): left panel x=0.2-3.4, right panel
// x=3.9-7.1.
//
// SPDX-License-Identifier: Apache-2.0

graph connection_check {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#fff2cc",
           fontname="Helvetica", fontsize=11, width=1.5, height=0.5,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=10];

    t1 [pos="1.8,4.3!", shape=plaintext, style="", width=3.2, fontsize=12,
        label="Single-signature powered device"];
    t2 [pos="5.5,4.3!", shape=plaintext, style="", width=3.2, fontsize=12,
        label="Dual-signature powered device"];

    // Left panel.
    pse1 [pos="0.9,2.4!", label="Power sourcing\nequipment", width=1.3,
          height=2.4, fillcolor="#fbe5d6"];
    ba1  [pos="2.8,3.2!", label="Bridge A", width=1.0];
    bb1  [pos="2.8,1.6!", label="Bridge B", width=1.0];
    sig1 [pos="2.8,2.4!", label="One signature", width=1.2, height=0.4];
    pse1 -- ba1 [penwidth=2.5, label="A: 3.7–57 V applied"];
    pse1 -- bb1 [label="B: detection"];
    ba1 -- sig1;
    bb1 -- sig1;
    r1 [pos="1.8,0.6!", label="B shows an invalid signature", width=2.6,
        height=0.4, fillcolor="#f4cccc"];

    // Right panel.
    pse2 [pos="4.6,2.4!", label="Power sourcing\nequipment", width=1.3,
          height=2.4, fillcolor="#fbe5d6"];
    ba2  [pos="6.5,3.2!", label="Circuit 1:\nbridge, signature", width=1.3,
          height=0.6];
    bb2  [pos="6.5,1.6!", label="Circuit 2:\nbridge, signature", width=1.3,
          height=0.6];
    pse2 -- ba2 [label="A: detection"];
    pse2 -- bb2 [label="B: detection"];
    r2 [pos="5.5,0.6!", label="A and B each show a valid signature",
        width=3.0, height=0.4, fillcolor="#e2f0d9"];
}
