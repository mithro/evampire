// One channel of power sourcing equipment with its sequence run by
// evampire's software (low-side switch arrangement). Every edge carries a
// text label; bold edges carry power, thin edges carry measurements and
// control.
//
// Fill colours: power circuits #fff2cc, evampire #dbe8f5, external parts
// and connectors #ffffff. Red outlines mark the blocks that see the full
// port voltage; the others sit near the supply return.
//
// SPDX-License-Identifier: Apache-2.0

digraph pse_channel {
    graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.3,
           ranksep=0.45, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=13];
    edge  [fontname="Helvetica", fontsize=12, arrowsize=0.7];

    vpwr [label="High-voltage converter\n44–57 V", fillcolor="#fff2cc"];
    port [label="Port: positive pairs\nto supply, negative\npairs to switch", fillcolor="#ffffff"];
    prot [label="Port protection:\n0.1 µF 100 V, TVS ≥ 58 V,\nfuse ≥ 60 V DC", fillcolor="#ffffff"];
    det  [label="Detection and\nclass source\nsees up to 57 V", fillcolor="#fff2cc",
          color="#c00000", penwidth=2];
    vmeas [label="Voltage\nmeasurement", fillcolor="#fff2cc"];
    fet  [label="Switch\n(power MOSFET)\nsees up to 57 V", fillcolor="#fff2cc",
          color="#c00000", penwidth=2];
    gate [label="Gate drive and\ncurrent-limit loop", fillcolor="#fff2cc"];
    rsns [label="Sense resistor", fillcolor="#ffffff"];
    imeas [label="Current\nmeasurement", fillcolor="#fff2cc"];
    fast [label="Fast fault\ncomparator", fillcolor="#fff2cc"];
    sw   [label="Software on\nevampire", fillcolor="#dbe8f5"];

    { rank=same; port; det; vmeas; }
    { rank=same; vpwr; prot; }
    { rank=same; fet; gate; }
    { rank=same; rsns; imeas; fast; }

    vpwr -> port  [penwidth=2.5, label="power"];
    port -> fet   [penwidth=2.5, label="power"];
    fet  -> rsns  [penwidth=2.5, label="power"];
    det  -> port  [label="test"];
    prot -> port  [arrowhead=none, label="across"];
    port -> vmeas [label="volts"];
    gate -> fet   [label="gate"];
    rsns -> imeas [label="mV"];
    rsns -> fast  [label="mV"];
    fast -> gate  [label="off"];
    vmeas -> sw   [label="reading"];
    imeas -> sw   [label="reading"];
    sw   -> det   [label="step"];
    sw   -> gate  [label="limit"];
}
