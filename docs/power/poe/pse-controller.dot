// One channel of a power sourcing equipment controller (low-side switch
// arrangement, as in the TI TPS2388x family). Bold arrows: power path.
// Thin arrows: measurement and control. Dashed arrows: host interface.
//
// SPDX-License-Identifier: Apache-2.0

digraph pse_controller {
    graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.25,
           ranksep=0.4, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    // External power path.
    vpwr [label="54 V supply\n(44–57 V)", fillcolor="#fbe5d6"];
    port [label="Port centre taps\n(+ to supply,\n− to MOSFET drain)", fillcolor="#ffffff"];
    fet  [label="Power MOSFET\n100 V (external)", fillcolor="#fbe5d6"];
    rsns [label="Sense resistor\n0.2 Ω (external)", fillcolor="#ffffff"];
    gnd  [label="Supply return\n(ground)", fillcolor="#ffffff"];
    host [label="Host processor\n(evampire)", fillcolor="#dbe8f5"];

    subgraph cluster_ic {
        label="Power sourcing equipment\ncontroller (one channel)";
        labelloc="t"; labeljust="l"; style="rounded,bold"; color="#1f4e79";

        det   [label="Detection\ncurrent sources"];
        vadc  [label="Voltage ADC"];
        logic [label="State machine,\ntimers, registers"];
        temp  [label="Thermal\nshutdown"];
        gate  [label="Gate driver and\ncurrent-limit loop"];
        iadc  [label="Current ADC"];
        fast  [label="Fast short-circuit\ncomparator"];
    }

    { rank=same; vpwr; }
    { rank=same; port; det; vadc; }
    { rank=same; logic; temp; }
    { rank=same; fet; gate; }
    { rank=same; rsns; iadc; fast; }
    { rank=same; gnd; host; }

    vpwr -> port [penwidth=2.5];
    port -> fet  [penwidth=2.5];
    fet  -> rsns [penwidth=2.5];
    rsns -> gnd  [penwidth=2.5];

    det   -> port;
    port  -> vadc [constraint=false];
    vadc  -> logic;
    det   -> logic [dir=back];
    temp  -> logic [constraint=false];
    logic -> gate;
    gate  -> fet  [constraint=false, label="gate"];
    rsns  -> iadc [constraint=false];
    rsns  -> fast [constraint=false];
    iadc  -> logic;
    fast  -> gate;
    logic -> host [style=dashed, dir=both, label="I2C"];
}
