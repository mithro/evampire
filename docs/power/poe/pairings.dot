// The four pairings of a port that can take either role with the
// equipment at the other end, and what happens in each. From
// dual-role.rst (IEEE 802.3 145.2.6 and 145.2.6.1).
//
// Fill colours: power circuits #fff2cc, far-end equipment #fbe5d6,
// outcome #ffffff. Fixed grid (positions in inches): a 2 by 2 grid.
//
// SPDX-License-Identifier: Apache-2.0

graph pairings {
    graph [layout=neato, splines=false, overlap=true, outputorder=edgesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=10, width=1.2, height=0.45, fixedsize=true];
    edge  [penwidth=1.6];

    a1 [pos="0.7,3.2!", label="PSE", fillcolor="#fff2cc"];
    b1 [pos="2.6,3.2!", label="PSE", fillcolor="#fbe5d6"];
    o1 [pos="1.65,2.55!", shape=plaintext, style="", width=3.3, height=0.6,
        label="each sees the other's source: invalid,\nno power; each withstands 5 mA fed back"];
    a1 -- b1;

    a2 [pos="4.5,3.2!", label="PD", fillcolor="#fff2cc"];
    b2 [pos="6.4,3.2!", label="PD", fillcolor="#fbe5d6"];
    o2 [pos="5.45,2.55!", shape=plaintext, style="", width=3.0, height=0.6,
        label="neither supplies a voltage:\nnothing happens"];
    a2 -- b2;

    a3 [pos="0.7,1.5!", label="PSE", fillcolor="#fff2cc"];
    b3 [pos="2.6,1.5!", label="no PoE", fillcolor="#fbe5d6"];
    o3 [pos="1.65,0.85!", shape=plaintext, style="", width=3.0, height=0.6,
        label="detection fails:\nno power applied"];
    a3 -- b3;

    a4 [pos="4.5,1.5!", label="PD", fillcolor="#fff2cc"];
    b4 [pos="6.4,1.5!", label="no PoE", fillcolor="#fbe5d6"];
    o4 [pos="5.45,0.85!", shape=plaintext, style="", width=3.0, height=0.6,
        label="no voltage arrives: the board\nruns from another source"];
    a4 -- b4;

    h1 [pos="0.7,3.75!", shape=plaintext, style="", width=1.3, height=0.3,
        fontsize=10, label="this port"];
    h2 [pos="2.6,3.75!", shape=plaintext, style="", width=1.3, height=0.3,
        fontsize=10, label="other end"];
}
