// Power over Ethernet on a first-version evampire board: port A receives
// power as a powered device, port B supplies power as power sourcing
// equipment. Every edge carries a text label; bold edges carry power, thin
// edges carry data, dashed edges carry control and measurements.
//
// Fill colours: far-end equipment #fbe5d6, power circuits on the board
// #fff2cc, evampire and the power bus #dbe8f5, connectors and transceivers
// #ffffff.
//
// The blocks are placed on a fixed grid (positions in inches) so that the
// diagram fits the width of a documentation page:
//
//   column 1 (x=1.1)  port A, power flowing down from the cable
//   column 2 (x=3.6)  Ethernet transceivers, evampire, internal power bus
//   column 3 (x=6.1)  port B, power flowing up to the cable
//
// SPDX-License-Identifier: Apache-2.0

digraph poe_system {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=12, width=1.8, height=0.6,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=10, arrowsize=0.8];

    // Outlines, drawn first so they sit behind the blocks.
    board [label="Board built around evampire", labelloc=b, fontsize=13,
           fontcolor="#555555", pos="3.6,5.35!", width=7.2, height=6.4,
           style="rounded,dashed", color="#888888", fillcolor="none"];
    port_a [label="Port A: powered device", labelloc=b, fontsize=12,
            fontcolor="#c55a11", pos="1.1,5.35!", width=2.1, height=4.9,
            style="rounded", color="#c55a11", fillcolor="none"];
    port_b [label="Port B: power sourcing\nequipment", labelloc=b,
            fontsize=12, fontcolor="#c55a11", pos="6.1,5.35!", width=2.1,
            height=4.9, style="rounded", color="#c55a11", fillcolor="none"];

    // Equipment at the far ends of the two cables.
    up   [pos="1.1,9.25!", label="Power sourcing\nequipment\n(switch or injector)",
          height=0.75, fillcolor="#fbe5d6"];
    down [pos="6.1,9.25!", label="Powered device\n(for example a\ncamera)",
          height=0.75, fillcolor="#fbe5d6"];

    // Port A column.
    maga [pos="1.1,7.0!", label="RJ45 and\nmagnetics A", fillcolor="#ffffff"];
    brg  [pos="1.1,6.0!", label="Two polarity\nbridges", fillcolor="#fff2cc"];
    pdc  [pos="1.1,5.0!", label="Signature, class\nand isolation switch", fillcolor="#fff2cc"];
    conv [pos="1.1,4.0!", label="Input converter", fillcolor="#fff2cc"];

    // Centre column.
    evp  [pos="3.6,5.0!", label="evampire", width=1.3, style="rounded,filled,bold",
          fillcolor="#dbe8f5"];
    bus  [pos="3.6,2.8!", label="Internal power bus", style="filled,bold",
          fillcolor="#dbe8f5"];

    // Ethernet transceivers (external chips in the first version).
    phya [pos="2.95,7.85!", label="Ethernet\ntransceiver A", width=1.1,
          height=0.6, fontsize=11, fillcolor="#ffffff"];
    phyb [pos="4.25,7.85!", label="Ethernet\ntransceiver B", width=1.1,
          height=0.6, fontsize=11, fillcolor="#ffffff"];

    // Port B column.
    boost [pos="6.1,4.0!", label="High-voltage\nconverter, 44–57 V", fillcolor="#fff2cc"];
    psec  [pos="6.1,5.0!", label="Detection, class,\nswitch and\ncurrent limit", height=0.75, fillcolor="#fff2cc"];
    magb  [pos="6.1,7.0!", label="RJ45 and\nmagnetics B", fillcolor="#ffffff"];

    // Power path.
    up    -> maga  [penwidth=2.5, label="cable  "];
    maga  -> brg   [penwidth=2.5, label="power  "];
    brg   -> pdc   [penwidth=2.5, label="power  "];
    pdc   -> conv  [penwidth=2.5, label="power  "];
    conv  -> bus   [penwidth=2.5, label="power"];
    bus   -> boost [penwidth=2.5, label="power"];
    boost -> psec  [penwidth=2.5, label="  power"];
    psec  -> magb  [penwidth=2.5, label="  power"];
    magb  -> down  [penwidth=2.5, label="  cable"];

    // Control and data.
    pdc  -> evp  [style=dashed, label="status"];
    evp  -> psec [style=dashed, dir=both, label="control"];
    maga -> phya [dir=both, label="data"];
    phya -> evp  [dir=both, label="RGMII"];
    evp  -> phyb [dir=both, label="RGMII"];
    phyb -> magb [dir=both, label="data"];
}
