// Power over Ethernet on a first-version evampire board: port A receives
// power as a powered device, port B supplies power as power sourcing
// equipment. Bold arrows: power. Thin arrows: data. Dashed arrows: control.
//
// SPDX-License-Identifier: Apache-2.0

digraph poe_system {
    graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.3,
           ranksep=0.4, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    up   [label="Power sourcing\nequipment\n(switch or injector)\n44–57 V", fillcolor="#fbe5d6"];
    down [label="Powered device\n(camera, access\npoint, ...)", fillcolor="#fbe5d6"];

    subgraph cluster_board {
        label="Board built around evampire"; labelloc="b";
        style="rounded,dashed"; color="#888888";

        subgraph cluster_a {
            label="Port A: powered device"; style="rounded"; color="#c55a11";
            maga [label="RJ45 and\nmagnetics A", fillcolor="#ffffff"];
            brg  [label="Two polarity\nbridges", fillcolor="#fff2cc"];
            pdc  [label="Powered-device\ncontroller", fillcolor="#fff2cc"];
            conv [label="Input\nconverter", fillcolor="#fff2cc"];
        }

        bus  [label="Internal\npower bus", style="filled,bold", fillcolor="#dbe8f5"];
        evp  [label="evampire", style="rounded,filled,bold", fillcolor="#dbe8f5"];

        subgraph cluster_b {
            label="Port B: power sourcing equipment"; style="rounded";
            color="#c55a11";
            boost [label="Boost converter\nto 44–57 V", fillcolor="#fff2cc"];
            psec  [label="PSE controller,\nswitches and\ncurrent sense", fillcolor="#fff2cc"];
            magb  [label="RJ45 and\nmagnetics B", fillcolor="#ffffff"];
        }
    }

    { rank=same; bus; evp; }

    up   -> maga  [penwidth=2.5, label="cable"];
    maga -> brg   [penwidth=2.5, label="centre\ntaps"];
    brg  -> pdc   [penwidth=2.5];
    pdc  -> conv  [penwidth=2.5, label="37–57 V"];
    conv -> bus   [penwidth=2.5];
    bus  -> boost [penwidth=2.5];
    boost -> psec [penwidth=2.5];
    psec -> magb  [penwidth=2.5, label="centre\ntaps"];
    magb -> down  [penwidth=2.5, label="cable"];

    pdc  -> evp   [style=dashed, label="power good,\nallocated power"];
    evp  -> psec  [style=dashed, dir=both, label="I2C or\nenable/status"];
    maga -> evp   [dir=both, label="data (via\ntransceiver A)", constraint=false];
    evp  -> magb  [dir=both, label="data (via\ntransceiver B)", constraint=false];
}
