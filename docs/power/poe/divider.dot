// Sensing the port voltage with a resistor divider: an external divider
// after the isolation switch, with a clamp on its output. Values from
// hv-options.rst.
//
// Fill colours: power circuits #fff2cc, evampire #dbe8f5, external parts
// #ffffff. Bold edges carry power. Fixed grid (positions in inches).
//
// SPDX-License-Identifier: Apache-2.0

digraph divider {
    graph [layout=neato, splines=false, overlap=true, outputorder=edgesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=10, width=1.5, height=0.5, fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.6];

    sig [pos="0.9,2.6!", label="Bridges and\nsignature", fillcolor="#fff2cc"];
    iso [pos="0.9,1.6!", label="Isolation switch", fillcolor="#fff2cc"];
    vin [pos="3.0,1.6!", label="Port voltage\nup to 57 V", fillcolor="#ffffff"];
    r1  [pos="3.0,0.9!", label="R1 1 MΩ", fillcolor="#ffffff", width=1.1, height=0.4];
    tap [pos="3.0,0.35!", shape=point, width=0.07];
    r2  [pos="3.0,-0.3!", label="R2 56 kΩ", fillcolor="#ffffff", width=1.1, height=0.4];
    cl  [pos="4.6,-0.3!", label="Clamp", fillcolor="#ffffff", width=0.8, height=0.4];
    adc [pos="5.4,0.35!", label="evampire input\n3.0 V at 57 V", fillcolor="#dbe8f5"];

    sig -> iso [penwidth=2.2];
    iso -> vin [penwidth=2.2];
    vin -> r1 [dir=none];
    r1 -> tap [dir=none, label=" 54 µA"];
    tap -> r2 [dir=none];
    tap -> adc;
    tap -> cl [dir=none];
    vss [pos="3.8,-0.95!", label="VSS", fillcolor="#ffffff", width=0.7, height=0.35];
    r2 -> vss [dir=none];
    cl -> vss [dir=none];
    n [pos="0.9,0.35!", shape=plaintext, style="", width=1.7, height=0.6,
       fontsize=9, label="not across the signature,\nso detection sees\nonly 25 kΩ"];
}
