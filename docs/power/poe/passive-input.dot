// A standard powered-device input beside a passive input path, as an
// alternative for a fallback input. From powered-device.rst.
//
// Fill colours: far-end equipment #fbe5d6, power circuits #fff2cc,
// evampire and the bus #dbe8f5. Bold edges carry power.
// Fixed grid (positions in inches).
//
// SPDX-License-Identifier: Apache-2.0

digraph passive_input {
    graph [layout=neato, splines=false, overlap=true, outputorder=edgesfirst,
           fontname="Helvetica"];
    node  [shape=box, style="rounded,filled", fillcolor="#fff2cc",
           fontname="Helvetica", fontsize=11, width=1.9, height=0.6,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=10, penwidth=2.2, arrowsize=0.7];

    std [pos="1.2,2.0!", label="Standard source:\ndetection and class", fillcolor="#fbe5d6"];
    pas [pos="1.2,0.7!", label="Passive source:\nfixed 24 V or 48 V", fillcolor="#fbe5d6"];
    br  [pos="3.5,1.35!", label="Bridges", width=1.1];
    pdp [pos="5.6,2.0!", label="Powered-device path:\nturn on at 30–42 V,\nclass known", height=0.75];
    pp  [pos="5.6,0.7!", label="Passive path:\nlower turn-on,\nno class", height=0.75];
    bus [pos="7.6,1.35!", label="Input converter\nand power bus", fillcolor="#dbe8f5",
         width=1.5];

    std -> br; pas -> br;
    br -> pdp; br -> pp;
    pdp -> bus; pp -> bus;
}
