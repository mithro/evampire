// The three places where the 2 ns RGMII clock delay can be added, in each
// direction: in the transmitting chip, on the board, or in the receiving
// chip. Exactly one of the three is used in each direction.
//
// Fixed grid, positions in inches. Top row: transmit. Bottom row: receive.
//
// SPDX-License-Identifier: Apache-2.0

digraph delay_places {
    graph [layout=neato, splines=false, outputorder=nodesfirst,
           fontname="Helvetica", fontsize=11];
    node  [fontname="Helvetica", fontsize=10, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, penwidth=1.4, arrowsize=0.7];

    // Board, then chips, drawn first so the delay boxes sit on top.
    board [pos="3.3,1.25!", width=6.9, height=2.9, fillcolor="#f4f8f0",
           color="#a9a9a9", labelloc=t, labeljust=c, fontsize=10,
           label="circuit board"];
    evampire [pos="0.95,1.1!", width=1.7, height=2.3, fillcolor="#dbe8f5",
              color="#1f4e79", labelloc=t, label="evampire"];
    phy [pos="5.65,1.1!", width=1.7, height=2.3, fillcolor="#ffffff",
         color="#555555", labelloc=t, label="Ethernet\ntransceiver"];

    // Ends of each path.
    node [shape=plaintext, style="", width=0.8, height=0.4, fontsize=9];
    txsrc [pos="0.5,1.55!", label="TXC, TXD\nsent"];
    txdst [pos="6.1,1.55!", label="TXD\nsampled"];
    rxsrc [pos="6.1,0.45!", label="RXC, RXD\nsent"];
    rxdst [pos="0.5,0.45!", label="RXD\nsampled"];

    // The three candidate places in each direction.
    node [shape=box, style="filled,dashed", fillcolor="#fff2cc",
          width=0.9, height=0.45, fontsize=9];
    tx1 [pos="1.4,1.55!", label="transmitter\ndelays TXC"];
    tx2 [pos="3.3,1.55!", width=1.1, label="board:\nlonger TXC trace"];
    tx3 [pos="5.2,1.55!", label="receiver\ndelays TXC"];
    rx1 [pos="5.2,0.45!", label="transmitter\ndelays RXC"];
    rx2 [pos="3.3,0.45!", width=1.1, label="board:\nlonger RXC trace"];
    rx3 [pos="1.4,0.45!", label="receiver\ndelays RXC"];

    node [shape=plaintext, style="", width=3.0, height=0.25, fontsize=10];
    txlab [pos="3.3,1.9!", label="Transmit, evampire to transceiver"];
    rxlab [pos="3.3,0.1!", label="Receive, transceiver to evampire"];

    txsrc -> tx1 -> tx2 -> tx3 -> txdst;
    rxsrc -> rx1 -> rx2 -> rx3 -> rxdst;
}
