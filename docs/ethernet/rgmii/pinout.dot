// evampire's RGMII and management pins: 6 transmit and 6 receive pins per
// port, MDC (driven by evampire) and MDIO (both ways) shared by both
// transceivers, and the 125 MHz reference clock from an oscillator or a
// transceiver. The MDIO pull-up is drawn in mdio-bus.dot.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

digraph pinout {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [penwidth=1.5, arrowsize=0.7, fontname="Helvetica", fontsize=9];

    ev [pos="0.7,1.6!", width=1.2, height=3.4, fillcolor="#dbe8f5",
        label="evampire\n\n27 pins"];
    pa [pos="4.3,2.65!", width=1.4, height=1.0, fillcolor="#ffffff",
        label="transceiver A"];
    pb [pos="4.3,0.95!", width=1.4, height=1.0, fillcolor="#ffffff",
        label="transceiver B"];
    osc [pos="4.3,-0.35!", width=1.8, height=0.55, fillcolor="#f2f2f2",
         label="125 MHz oscillator, or\nCLK_OUT or CLK125_NDO\nof a transceiver"];

    node [shape=point, width=0.01, height=0.01, style=invis];
    e1 [pos="1.3,2.95!"]; a1 [pos="3.6,2.95!"];
    e2 [pos="1.3,2.65!"]; a2 [pos="3.6,2.65!"];
    e3 [pos="1.3,1.1!"]; b3 [pos="3.6,1.1!"];
    e4 [pos="1.3,0.8!"]; b4 [pos="3.6,0.8!"];
    e5 [pos="1.3,2.38!"]; k5 [pos="3.25,2.38!"]; a5 [pos="3.6,2.38!"];
    k5b [pos="3.25,1.3!"]; b5 [pos="3.6,1.3!"];
    e7 [pos="1.3,2.12!"]; k7 [pos="3.0,2.12!"]; a7 [pos="3.6,2.12!"];
    k7b [pos="3.0,1.42!"]; b7 [pos="3.6,1.42!"];
    e6 [pos="1.3,0.15!"]; k6 [pos="2.4,0.15!"]; o6 [pos="3.5,-0.35!"];
    k6b [pos="2.4,-0.35!"];

    node [shape=plaintext, style="", width=2.2, height=0.2, fontsize=9];
    l1 [pos="2.35,3.07!", label="TXC, TX_CTL, TXD[3:0]: 6 pins"];
    l2 [pos="2.35,2.77!", label="RXC, RX_CTL, RXD[3:0]: 6 pins"];
    l3 [pos="2.05,2.5!", width=1.4, label="MDC: 1 pin, shared"];
    l7 [pos="2.25,2.24!", width=1.7, label="MDIO: 1 pin, both ways"];
    l4 [pos="2.35,1.22!", label="TXC, TX_CTL, TXD[3:0]: 6 pins"];
    l5 [pos="2.35,0.92!", label="RXC, RX_CTL, RXD[3:0]: 6 pins"];
    l6 [pos="2.15,0.27!", width=1.5, label="125 MHz clock: 1 pin"];

    e1 -> a1 [color="#1f4e79"];
    a2 -> e2 [color="#c55a11"];
    e3 -> b3 [color="#1f4e79"];
    b4 -> e4 [color="#c55a11"];
    e5 -> k5 [dir=none, color="#548235"];
    k5 -> a5 [color="#548235"];
    k5 -> k5b [dir=none, color="#548235"];
    k5b -> b5 [color="#548235"];
    e7 -> k7 [dir=back, color="#7030a0"];
    k7 -> a7 [color="#7030a0"];
    k7 -> k7b [dir=none, color="#7030a0"];
    k7b -> b7 [color="#7030a0"];
    o6 -> k6b [dir=none, color="#7f7f7f"];
    k6b -> k6 [dir=none, color="#7f7f7f"];
    k6 -> e6 [color="#7f7f7f"];
}
