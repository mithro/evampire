// Receive input stage for one RGMII data bit.
//
// SPDX-License-Identifier: Apache-2.0

digraph rx_ddr {
    graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.45,
           ranksep=0.7, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=10];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7];

    pin  [label="RXD[n]\npin", shape=plaintext, style=""];
    pad  [label="Input\npad", fillcolor="#e2e2e2"];
    ffr  [label="Flip-flop R\nloads on the\nrising edge", fillcolor="#dbe8f5"];
    fff  [label="Flip-flop F\nloads on the\nfalling edge", fillcolor="#dbe8f5"];
    byte [label="Byte register\n(loads on the\nnext rising edge)",
          fillcolor="#e2efda"];
    fifo [label="Rate-matching\nbuffer", fillcolor="#f2f2f2"];
    cpin [label="RXC\npin", shape=plaintext, style=""];
    cpad [label="Input\npad", fillcolor="#e2e2e2"];
    ctree [label="Small local\nclock buffer", fillcolor="#fbe5d6"];

    pin -> pad;
    pad -> ffr;
    pad -> fff;
    ffr -> byte [label="bit n"];
    fff -> byte [label="bit n+4"];
    byte -> fifo;

    cpin -> cpad -> ctree;
    ctree -> ffr  [style=dashed];
    ctree -> fff  [style=dashed, xlabel="inverted "];
    ctree -> byte [style=dashed];

    { rank=same; pin; cpin; }
    { rank=same; pad; cpad; }
    { rank=same; ffr; fff; ctree; }
    ffr -> fff -> ctree [style=invis];
}
