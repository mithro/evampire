// Common-mode divider of a capacitor-coupled pair: the cable's common-mode
// voltage reaches the chip-side common-mode node through the pair's two
// coupling capacitors in parallel, and the chip holds that node at its
// bias voltage through a resistance R_cm.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

graph cm_divider {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true, height=0.7];
    edge  [penwidth=1.5];

    vc [pos="0.5,0.8!", width=1.0, fillcolor="#fbe5d6",
        label="cable\ncommon-mode\nvoltage\nV_cable"];
    cw [pos="1.95,0.8!", width=1.1, fillcolor="#fff2cc",
        label="2 C_w\nthe pair's two\ncapacitors in\nparallel"];
    rcm [pos="3.75,0.8!", width=0.8, height=0.45, fillcolor="#ffffff",
         label="R_cm"];
    bias [pos="5.0,0.8!", width=0.9, height=0.5, fillcolor="#dbe8f5",
          label="bias\nvoltage"];

    node [shape=plaintext, style="", width=1.6, height=0.35, fontsize=9];
    lnode [pos="3.25,1.25!", width=1.3, label="chip-side\ncommon-mode node"];
    lv [pos="3.75,0.38!", width=1.3, fontcolor="#c00000",
        label="V_chip across R_cm"];
    lg [pos="2.75,-0.15!", width=2.2, label="chip ground"];

    node [shape=point, width=0.07, height=0.07, style=filled,
          fillcolor="#000000"];
    jn [pos="3.05,0.8!"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    g1 [pos="0.5,0.0!"]; g2 [pos="5.0,0.0!"];

    vc -- cw -- jn -- rcm -- bias;
    vc -- g1 -- g2 -- bias [color="#7f7f7f"];
}
