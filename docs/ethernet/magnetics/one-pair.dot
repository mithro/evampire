// One twisted pair between an Ethernet transceiver and the RJ45 socket.
//
// SPDX-License-Identifier: Apache-2.0

digraph one_pair {
    graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35,
           ranksep=0.55, splines=spline, newrank=true];
    node  [fontname="Helvetica", fontsize=10, shape=plain];
    edge  [fontname="Helvetica", fontsize=9, arrowhead=none, penwidth=1.3];

        phy [label=<
          <table border="1" cellborder="0" cellspacing="0" cellpadding="6"
                 bgcolor="#dbe8f5">
            <tr><td colspan="2"><b>Transceiver</b></td></tr>
            <tr><td></td><td port="p" align="right">pair A +</td></tr>
            <tr><td></td><td>&nbsp;</td></tr>
            <tr><td></td><td port="n" align="right">pair A −</td></tr>
          </table>>];

        c_ct [label=<
          <table border="1" cellborder="0" cellspacing="0" cellpadding="4"
                 bgcolor="#ffffff">
            <tr><td><b>0.1 µF</b></td></tr>
            <tr><td><font point-size="9">to signal ground<br/>(voltage-mode driver;<br/>see the centre-tap section)</font></td></tr>
          </table>>];

    xfmr [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="5"
             bgcolor="#fff2cc">
        <tr><td colspan="3"><b>Isolation transformer, 1:1</b></td></tr>
        <tr><td align="left"><font point-size="9" color="#1f4e79">circuit side</font></td><td></td><td align="right"><font point-size="9" color="#c55a11">cable side</font></td></tr>
        <tr><td port="lp" align="left">●</td><td rowspan="3">winding ║ winding<br/><font point-size="9">(isolation barrier)</font></td><td port="rp" align="right">●</td></tr>
        <tr><td port="lct" align="left">centre tap</td><td port="rct" align="right">centre tap</td></tr>
        <tr><td port="ln" align="left">●</td><td port="rn" align="right">●</td></tr>
      </table>>];

        cmc [label=<
          <table border="1" cellborder="0" cellspacing="0" cellpadding="5"
                 bgcolor="#e2efda">
            <tr><td colspan="3"><b>Common-mode choke</b></td></tr>
            <tr><td port="ip">●</td><td rowspan="2">two windings<br/>on one core</td><td port="op">●</td></tr>
            <tr><td port="in">●</td><td port="on">●</td></tr>
          </table>>];

        rj45 [label=<
          <table border="1" cellborder="0" cellspacing="0" cellpadding="6"
                 bgcolor="#f2f2f2">
            <tr><td><b>RJ45 socket</b></td></tr>
            <tr><td port="p1" align="left">pin 1</td></tr>
            <tr><td port="p2" align="left">pin 2</td></tr>
            <tr><td port="sh" align="left">metal shield</td></tr>
          </table>>];

        r75 [label=<
          <table border="1" cellborder="0" cellspacing="0" cellpadding="4"
                 bgcolor="#ffffff">
            <tr><td><b>75 Ω</b></td></tr>
          </table>>];


        chv [label=<
          <table border="1" cellborder="0" cellspacing="0" cellpadding="4"
                 bgcolor="#ffffff">
            <tr><td><b>1000 pF, 2 kV</b></td></tr>
            <tr><td><font point-size="9">one capacitor shared by<br/>the 75 Ω resistors<br/>of all four pairs</font></td></tr>
          </table>>];

    chassis [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="5"
             bgcolor="#d9d9d9">
        <tr><td><b>Chassis ground</b></td></tr>
      </table>>];

    // Signal path.
    phy:p   -> xfmr:lp;
    phy:n   -> xfmr:ln;
    xfmr:rp -> cmc:ip;
    xfmr:rn -> cmc:in;
    cmc:op  -> rj45:p1;
    cmc:on  -> rj45:p2;

    // Chip-side centre tap.
    xfmr:lct -> c_ct [style=dashed, color="#1f4e79"];

    // Cable-side centre tap and common-mode termination.
    xfmr:rct -> r75 [style=dashed, color="#c55a11"];
    r75      -> chv [style=dashed, color="#c55a11"];
    chv      -> chassis [style=dashed, color="#c55a11"];
    rj45:sh  -> chassis [style=dashed, color="#808080"];

    // Columns, left to right; within a column the first node is on top.
    { rank=same; phy -> c_ct [style=invis]; }
    { rank=same; cmc -> r75 [style=invis]; }
    { rank=same; rj45 -> chv [style=invis]; }
}
