// What a transformer passes and blocks on one pair: the differential
// signal crosses, common-mode voltage and direct current do not, so each
// side sits at its own voltage. The capacitance between the windings
// passes some common mode at high frequencies.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

graph cm_transformer {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [penwidth=1.6];

    phy [pos="0.6,1.5!", width=1.1, height=1.1, fillcolor="#dbe8f5",
         label="transceiver\nside:\nnear its own\nsupply"];
    x [pos="2.7,1.5!", width=1.2, height=1.1, fillcolor="#fff2cc",
       label="transformer\n\ncouples only\nthe voltage\nacross a winding"];
    cab [pos="4.85,1.5!", width=1.3, height=1.1, fillcolor="#fbe5d6",
         label="cable side:\nat the far end's,\na ground\ndifference's or\nPoE voltage"];

    node [shape=point, width=0.01, height=0.01, style=invis];
    pp [pos="1.15,1.8!"]; pn [pos="1.15,1.2!"];
    xlp [pos="2.1,1.8!"]; xln [pos="2.1,1.2!"];
    xrp [pos="3.3,1.8!"]; xrn [pos="3.3,1.2!"];
    cp [pos="4.2,1.8!"];  cn [pos="4.2,1.2!"];
    k1 [pos="3.75,1.2!"]; k2 [pos="3.75,0.55!"];
    k3 [pos="1.65,0.55!"]; k4 [pos="1.65,1.2!"];

    pp -- xlp; pn -- xln;
    xrp -- cp; xrn -- cn;
    k1 -- k2 -- k3 -- k4 [style=dashed, color="#7f7f7f"];

    node [shape=plaintext, style="", height=0.2, fontsize=9];
    l1 [pos="2.7,2.3!", width=3.6, fontcolor="#1f4e79",
        label="differential signal: passes"];
    l2 [pos="2.7,2.1!", width=3.6, fontcolor="#c00000",
        label="common-mode voltage and direct current: blocked"];
    l3 [pos="2.7,0.4!", width=4.2, fontcolor="#7f7f7f",
        label="capacitance between the windings: passes some"];
    l4 [pos="2.7,0.22!", width=4.2, fontcolor="#7f7f7f",
        label="high-frequency common mode, so a choke is added"];
}
