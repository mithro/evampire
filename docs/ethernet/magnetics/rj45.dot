// The eight RJ45 contacts in numbered order and the four pairs they form,
// with the MDI assignment. Pair B uses contacts 3 and 6, on either side of
// pair C on contacts 4 and 5.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

graph rj45 {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true, width=0.62, height=0.55];
    edge  [penwidth=1.6];

    c1 [pos="0.4,2.0!", fillcolor="#dbe8f5", label="1\nBI_DA+"];
    c2 [pos="1.1,2.0!", fillcolor="#dbe8f5", label="2\nBI_DA−"];
    c3 [pos="1.8,2.0!", fillcolor="#fbe5d6", label="3\nBI_DB+"];
    c4 [pos="2.5,2.0!", fillcolor="#e2efda", label="4\nBI_DC+"];
    c5 [pos="3.2,2.0!", fillcolor="#e2efda", label="5\nBI_DC−"];
    c6 [pos="3.9,2.0!", fillcolor="#fbe5d6", label="6\nBI_DB−"];
    c7 [pos="4.6,2.0!", fillcolor="#fff2cc", label="7\nBI_DD+"];
    c8 [pos="5.3,2.0!", fillcolor="#fff2cc", label="8\nBI_DD−"];

    node [width=1.3, height=0.5, fontsize=9];
    pa [pos="0.75,0.95!", fillcolor="#dbe8f5",
        label="pair A\n10/100: transmit"];
    pc [pos="2.85,1.35!", fillcolor="#e2efda", width=1.0, height=0.4,
        fontsize=8, label="pair C\n10/100: not used"];
    pb [pos="2.85,0.3!", fillcolor="#fbe5d6",
        label="pair B\n10/100: receive"];
    pd [pos="4.95,0.95!", fillcolor="#fff2cc",
        label="pair D\n10/100: not used"];

    c1 -- pa [color="#1f4e79"];  c2 -- pa [color="#1f4e79"];
    c4 -- pc [color="#548235"];  c5 -- pc [color="#548235"];
    c3 -- pb [color="#c55a11"];  c6 -- pb [color="#c55a11"];
    c7 -- pd [color="#bf9000"];  c8 -- pd [color="#bf9000"];
}
