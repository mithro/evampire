// A Power over Ethernet inductor across a capacitor-coupled pair: the
// series coupling capacitors and the inductor across the pair are two
// high-pass elements, and the inductor must be at least 80 uH.
// Counterpart of cap-model.dot.
//
// Fixed grid, positions in inches. Top row: wire +. Bottom row: wire -.
//
// SPDX-License-Identifier: Apache-2.0

graph inductor_droop {
    graph [layout=neato, splines=line, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fillcolor="#ffffff"];
    edge  [fontname="Helvetica", fontsize=9, penwidth=1.3];

    src [pos="0.4,0.5!", width=1.0, height=1.2, fixedsize=true,
         fillcolor="#dbe8f5", label="Transceiver\n\nsource\nR_s = 100 Ω"];
    cp [pos="1.9,1.0!", width=0.6, height=0.35, fixedsize=true,
        fillcolor="#fff2cc", label="C_w"];
    cn [pos="1.9,0.0!", width=0.6, height=0.35, fixedsize=true,
        fillcolor="#fff2cc", label="C_w"];
    lm [pos="3.1,0.5!", width=1.1, height=0.45, fixedsize=true,
        fillcolor="#e2efda", label="inductor,\n80 µH or more"];
    load [pos="4.6,0.5!", width=1.0, height=1.2, fixedsize=true,
          fillcolor="#f2f2f2", label="Cable\n\nload\nZ_0 = 100 Ω"];
    note [pos="2.5,-0.45!", shape=plaintext, style="", width=4.8,
          height=0.2, fixedsize=true,
          label="two high-pass elements: series C_w and the inductor across the pair"];

    node [shape=point, width=0.01, height=0.01, style=invis, fixedsize=true];
    sp [pos="0.9,1.0!"]; sn [pos="0.9,0.0!"];
    lp [pos="4.1,1.0!"]; ln [pos="4.1,0.0!"];
    node [shape=point, width=0.07, height=0.07, style=filled,
          fillcolor="#000000"];
    jp [pos="3.1,1.0!"]; jn [pos="3.1,0.0!"];

    sp -- cp -- jp -- lp;
    sn -- cn -- jn -- ln;
    jp -- lm -- jn [color="#548235"];
}
