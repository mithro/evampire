// Capacitance that the coupling capacitors add to the detection
// signature of a powered device. Each powered pair's two capacitors are
// in parallel, 2 C_w, to one chip ground, so the two pairs are joined
// through two such groups in series, C_w in all, in parallel with the
// signature.
//
// Fixed grid, positions in inches. Top: one powered pair. Bottom: the
// other.
//
// SPDX-License-Identifier: Apache-2.0

graph cap_signature {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [penwidth=1.5];

    pse [pos="0.4,1.25!", width=0.75, height=2.3, fillcolor="#fbe5d6",
         label="detection\nsource,\n2.7 V to\n10.1 V,\nacross the\ntwo pairs"];
    sig [pos="1.8,1.25!", width=1.35, height=0.6, fillcolor="#e2efda",
         label="signature\n23.7 kΩ to 26.3 kΩ,\n50 nF to 120 nF"];

    node [width=0.5, height=0.26, fillcolor="#fff2cc"];
    c1 [pos="2.8,2.3!", label="C_w"]; c2 [pos="2.8,1.9!", label="C_w"];
    c3 [pos="2.8,0.6!", label="C_w"]; c4 [pos="2.8,0.2!", label="C_w"];

    gnd [pos="4.15,1.25!", width=0.8, height=0.4, fillcolor="#dbe8f5",
         label="chip\nground"];

    node [shape=plaintext, style="", width=1.2, height=0.2, fontsize=9];
    l1 [pos="2.0,2.45!", label="powered pair 1"];
    l2 [pos="2.0,0.05!", label="powered pair 2"];
    g1 [pos="3.55,2.25!", width=0.6, label="2 C_w"];
    g2 [pos="3.55,0.25!", width=0.6, label="2 C_w"];
    n1 [pos="5.4,1.25!", width=1.6, height=0.8, fontcolor="#c00000",
        label="2 C_w in series\nwith 2 C_w:\nC_extra = C_w,\nin parallel with\nthe signature"];

    node [shape=point, width=0.07, height=0.07, style=filled,
          fillcolor="#000000"];
    p1a [pos="1.0,2.3!"]; p1b [pos="1.0,1.9!"];
    p2a [pos="1.0,0.6!"]; p2b [pos="1.0,0.2!"];
    s1 [pos="1.8,1.9!"]; s2 [pos="1.8,0.6!"];
    q1 [pos="3.3,2.1!"]; q2 [pos="3.3,0.4!"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    e1a [pos="0.78,2.3!"]; e1b [pos="0.78,1.9!"];
    e2a [pos="0.78,0.6!"]; e2b [pos="0.78,0.2!"];
    r1a [pos="3.3,2.3!"]; r1b [pos="3.3,1.9!"];
    r2a [pos="3.3,0.6!"]; r2b [pos="3.3,0.2!"];
    u1 [pos="4.15,2.1!"]; u2 [pos="4.15,0.4!"];

    e1a -- p1a -- c1 -- r1a -- q1;
    e1b -- p1b -- s1 -- c2 -- r1b -- q1;
    e2a -- p2a -- s2 -- c3 -- r2a -- q2;
    e2b -- p2b -- c4 -- r2b -- q2;
    p1a -- p1b; p2a -- p2b;
    s1 -- sig -- s2 [color="#548235"];
    q1 -- u1 -- gnd [color="#1f4e79"];
    q2 -- u2 -- gnd [color="#1f4e79"];
}
