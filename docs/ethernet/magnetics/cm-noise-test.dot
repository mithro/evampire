// The common-mode noise test of 1000BASE-T: a 1.0 V rms signal swept from
// 1 MHz to 250 MHz is coupled onto all four pairs of a 100 m cable by a
// clamp 20 cm from the receiver. Magnetics reject it before the
// transceiver; coupling capacitors pass it, so the receiver and any choke
// must reject it.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

digraph cm_noise_test {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [penwidth=1.5, arrowsize=0.6];

    lp [pos="0.45,1.3!", width=0.8, height=0.7, fillcolor="#ffffff",
        label="link\npartner"];
    cab [pos="2.3,1.3!", width=2.6, height=0.35, fillcolor="#f2f2f2",
         label="100 m cable, all four pairs"];
    clamp [pos="3.95,1.3!", width=0.5, height=0.7, fillcolor="#fbe5d6",
           label="clamp"];
    gen [pos="3.95,2.3!", width=1.6, height=0.55, fillcolor="#fbe5d6",
         label="1.0 V rms, swept\n1 MHz to 250 MHz"];
    path [pos="5.15,1.3!", width=1.4, height=0.9, fillcolor="#fff2cc",
          label="magnetics: reject it\nor\ncapacitors: pass it\n(33 nF: 4.8 Ω at 1 MHz)"];
    rx [pos="6.55,1.3!", width=0.95, height=0.9, fillcolor="#dbe8f5",
        label="receiver"];
    gen -> clamp;
    lp -> cab [dir=none]; cab -> clamp [dir=none];
    clamp -> path [dir=none]; path -> rx [dir=none];

    node [shape=plaintext, style="", height=0.2, fontsize=9];
    d [pos="4.5,0.75!", width=0.8, label="20 cm"];
    t [pos="3.6,0.2!", width=5.4,
       label="target: under 30 mV peak to peak differential, so CMRR of 39.5 dB or more"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    m1 [pos="3.95,0.9!"]; m2 [pos="6.07,0.9!"];
    m1 -> m2 [dir=both, color="#7f7f7f", penwidth=1];
}
