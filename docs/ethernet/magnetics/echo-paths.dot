// With coupling capacitors at the near end and a transformer at the far
// end, the echo passes one high-pass filter and the far-end signal two.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

digraph echo_paths {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true, height=0.7];
    edge  [penwidth=1.6, arrowsize=0.6];

    ne [pos="0.5,0.9!", width=0.9, fillcolor="#dbe8f5",
        label="near-end\ntransceiver"];
    cw [pos="1.75,0.9!", width=0.9, fillcolor="#fff2cc",
        label="coupling\ncapacitors:\nhigh-pass 1"];
    cab [pos="3.2,0.9!", width=1.2, height=0.45, fillcolor="#f2f2f2",
         label="cable"];
    xf [pos="4.65,0.9!", width=0.9, fillcolor="#fff2cc",
        label="far-end\ntransformer:\nhigh-pass 2"];
    fe [pos="5.9,0.9!", width=0.9, fillcolor="#ffffff",
        label="far-end\ntransceiver"];

    node [shape=point, width=0.01, height=0.01, style=invis];
    a1 [pos="5.9,1.5!"]; a2 [pos="0.5,1.5!"];
    e1 [pos="1.3,0.35!"]; e2 [pos="2.4,0.35!"];

    ne -> cw [dir=none]; cw -> cab [dir=none]; cab -> xf [dir=none];
    xf -> fe [dir=none];
    a1 -> a2 [color="#1f4e79"];
    e2 -> e1 [color="#c00000"];

    node [shape=plaintext, style="", width=4.0, height=0.2, fontsize=9];
    t1 [pos="3.2,1.65!", fontcolor="#1f4e79",
        label="far-end signal: passes high-pass 2, then high-pass 1"];
    t2 [pos="3.6,0.35!", width=2.2, fontcolor="#c00000",
        label="echo: passes high-pass 1 only"];
}
