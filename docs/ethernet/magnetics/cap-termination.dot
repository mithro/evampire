// Common-mode termination of a capacitor-coupled pair, which has no
// centre tap. Left: external termination on the cable side, two resistors
// forming the centre tap, a blocking capacitor when Power over Ethernet is
// present, and the capacitor to chassis shared by the four pairs. Right:
// active common-mode termination on evampire, behind the capacitors.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

graph cap_termination {
    graph [layout=neato, splines=false, outputorder=nodesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [penwidth=1.5];

    node [shape=plaintext, style="", width=2.6, height=0.25, fontsize=10];
    h1 [pos="1.4,3.0!", label="External, on the cable side"];
    h2 [pos="4.9,3.0!", label="Active, on evampire"];

    // ---- External termination. ----
    node [shape=box, style=filled, fontsize=9];
    cab1 [pos="0.3,1.7!", width=0.5, height=1.6, fillcolor="#fbe5d6",
          label="cable"];
    cp1 [pos="2.4,2.4!", width=0.5, height=0.3, fillcolor="#fff2cc",
         label="C_w"];
    cn1 [pos="2.4,1.0!", width=0.5, height=0.3, fillcolor="#fff2cc",
         label="C_w"];
    r1 [pos="1.2,2.0!", width=0.35, height=0.35, fillcolor="#ffffff",
        label="R"];
    r2 [pos="1.2,1.4!", width=0.35, height=0.35, fillcolor="#ffffff",
        label="R"];
    cb [pos="1.9,1.7!", width=0.7, height=0.55, fillcolor="#ffffff",
        label="blocking\ncapacitor,\nwith PoE"];
    cch [pos="1.9,0.45!", width=1.1, height=0.45, fillcolor="#ffffff",
         label="capacitor shared\nby the four pairs"];
    chas [pos="1.9,-0.1!", width=1.0, height=0.3, fillcolor="#d9d9d9",
          label="chassis"];
    chip1 [pos="3.1,1.7!", width=0.5, height=1.6, fillcolor="#dbe8f5",
           label="chip"];

    node [shape=point, width=0.07, height=0.07, style=filled,
          fillcolor="#000000"];
    p1 [pos="1.2,2.4!"]; n1 [pos="1.2,1.0!"]; m1 [pos="1.2,1.7!"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    k1 [pos="2.25,1.7!"]; k2 [pos="2.25,0.45!"];
    e1 [pos="0.55,2.4!"]; e2 [pos="0.55,1.0!"];
    f1 [pos="2.85,2.4!"]; f2 [pos="2.85,1.0!"];
    q1 [pos="1.9,1.2!"];

    e1 -- p1 -- cp1 -- f1;
    e2 -- n1 -- cn1 -- f2;
    p1 -- r1 -- m1 -- r2 -- n1 [color="#c55a11"];
    m1 -- cb [color="#c55a11"];
    cb -- q1 -- cch -- chas [color="#c55a11"];

    // ---- Active termination. ----
    node [shape=box, style=filled, fontsize=9];
    cab2 [pos="3.9,1.7!", width=0.5, height=1.6, fillcolor="#fbe5d6",
          label="cable"];
    cp2 [pos="4.8,2.4!", width=0.5, height=0.3, fillcolor="#fff2cc",
         label="C_w"];
    cn2 [pos="4.8,1.0!", width=0.5, height=0.3, fillcolor="#fff2cc",
         label="C_w"];
    chip2 [pos="5.85,1.7!", width=1.3, height=1.9, fillcolor="#eef4fa",
           color="#1f4e79", labelloc=b, label="evampire"];
    loop [pos="5.85,1.7!", width=1.1, height=0.75, fillcolor="#dbe8f5",
          label="common-mode\nfeedback loop\npresents about\n75 Ω"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    g1 [pos="4.15,2.4!"]; g2 [pos="4.15,1.0!"];
    s1 [pos="5.85,2.4!"]; s2 [pos="5.85,1.0!"];
    node [shape=point, width=0.07, height=0.07, style=filled,
          fillcolor="#000000"];
    t1 [pos="5.35,2.4!"]; t2 [pos="5.35,1.0!"];
    g1 -- cp2 -- t1 -- s1;
    g2 -- cn2 -- t2 -- s2;
    s1 -- loop -- s2 [color="#1f4e79"];
}
