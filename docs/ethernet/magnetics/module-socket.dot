// The two ways to buy standard magnetics for one port: a discrete module
// between the transceiver and an ordinary RJ45 socket, with separate
// termination parts, or an RJ45 socket with the magnetics, in most parts
// the termination, and often two LEDs inside its shield.
//
// Fixed grid, positions in inches. Top: discrete module. Bottom:
// integrated socket.
//
// SPDX-License-Identifier: Apache-2.0

graph module_socket {
    graph [layout=neato, splines=false, outputorder=nodesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true, height=0.55];
    edge  [penwidth=1.5];

    node [shape=plaintext, style="", width=3.4, height=0.25, fontsize=10];
    h1 [pos="2.4,2.6!", label="Discrete module"];
    h2 [pos="2.4,1.05!", label="RJ45 socket with integrated magnetics"];

    node [shape=box, style=filled, fontsize=9, height=0.55];
    p1 [pos="0.5,2.0!", width=0.8, fillcolor="#dbe8f5", label="trans-\nceiver"];
    m1 [pos="1.9,2.0!", width=1.3, fillcolor="#fff2cc",
        label="four-channel\nmagnetics module"];
    r1 [pos="3.5,2.0!", width=1.0, fillcolor="#f2f2f2",
        label="ordinary\nRJ45 socket"];
    t1 [pos="1.9,1.4!", width=2.4, height=0.35, fillcolor="#ffffff",
        label="75 Ω resistors and 1000 pF, separate"];
    p1 -- m1 -- r1;
    m1 -- t1 [style=dashed];

    p2 [pos="0.5,0.48!", width=0.8, fillcolor="#dbe8f5", label="trans-\nceiver"];
    s2 [pos="2.9,0.4!", width=3.0, height=0.75, fillcolor="#f2f2f2",
        color="#555555", labelloc=b, label="shielded RJ45 socket"];
    m2 [pos="2.25,0.48!", width=1.0, height=0.4, fillcolor="#fff2cc",
        label="magnetics"];
    t2 [pos="3.25,0.48!", width=0.8, height=0.4, fillcolor="#ffffff",
        label="termination"];
    l2 [pos="4.0,0.48!", width=0.5, height=0.4, fillcolor="#fff2cc",
        label="LEDs"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    e2 [pos="1.4,0.48!"];
    p2 -- e2 -- m2;
    m2 -- t2;
}
