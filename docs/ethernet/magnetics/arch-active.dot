// The active front end, one pair shown: the same structure as
// arch-capacitor.dot with three changes, marked in red: on-chip
// common-mode feedback and termination in place of the choke, an
// external high-voltage transistor driven by evampire in place of the
// centre-tapped inductor, and part of the clamping moved onto evampire.
//
// Fixed grid, positions in inches.
//
// SPDX-License-Identifier: Apache-2.0

graph arch_active {
    graph [layout=neato, splines=line, outputorder=nodesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, shape=box, style="filled",
           fillcolor="#ffffff", pin=true, fixedsize=true];
    edge  [penwidth=1.2];

    chip [pos="5.95,2.1!", width=2.5, height=3.9, label="evampire",
          labelloc=t, fontsize=11, fontcolor="#1f4e79", color="#1f4e79",
          style="rounded,bold", fillcolor="none"];

    rj45 [pos="0.6,3.0!", width=0.95, height=0.75, fillcolor="#f2f2f2",
          label="RJ45\npins 1, 2\n(one pair)"];
    nochoke [pos="2.0,3.0!", width=1.15, height=0.55, color="#c00000",
             fontcolor="#c00000", style="dashed",
             label="no choke:\nreplaced on chip"];
    act [pos="2.0,1.85!", width=1.25, height=0.7, fillcolor="#fbe5d6",
         color="#c00000", label="external high-\nvoltage transistor\n(active inductor)"];
    poe [pos="2.0,0.45!", width=1.35, height=0.75, fillcolor="#fbe5d6",
         label="Power over Ethernet\nbridge or switch\nand controller"];
    term [pos="0.6,1.55!", width=1.0, height=0.8,
          label="common-mode\ntermination\nto chassis"];
    ccap [pos="3.6,3.0!", width=1.0, height=0.65, fillcolor="#fff2cc",
          label="high-voltage\ncoupling\ncapacitors"];
    clamp [pos="3.6,1.75!", width=1.0, height=0.65,
           label="external\nclamps, fewer"];

    node [fillcolor="#dbe8f5"];
    drv  [pos="6.05,3.35!", width=1.9, height=0.45,
          label="line driver with synthesised\n100 Ω termination"];
    rx   [pos="6.05,2.7!", width=1.9, height=0.45,
          label="receiver: wide common-mode\nrange, high rejection"];
    cm   [pos="6.05,2.05!", width=1.9, height=0.45, color="#c00000",
          label="common-mode feedback\nand termination"];
    prot [pos="6.05,1.4!", width=1.9, height=0.45, color="#c00000",
          label="custom clamps on chip"];
    ctl  [pos="6.05,0.6!", width=1.9, height=0.55, color="#c00000",
          label="control of the\nexternal transistor"];

    pins [pos="4.85,2.3!", width=0.16, height=2.85, fillcolor="#1f4e79",
          label=""];

    node [shape=point, width=0.01, height=0.01, style=invis, fixedsize=true];
    pin_in   [pos="4.77,3.0!"];
    pin_drv  [pos="4.93,3.35!"];
    pin_rx   [pos="4.93,2.7!"];
    pin_cm   [pos="4.93,2.05!"];
    pin_prot [pos="4.93,1.4!"];
    c_out    [pos="4.85,0.6!"];
    q1       [pos="3.0,0.6!"];
    q2       [pos="3.0,1.85!"];

    edge [fontname="Helvetica", fontsize=8];
    rj45 -- nochoke [penwidth=2.2, color="#2e75b6"];
    nochoke -- ccap [penwidth=2.2, color="#2e75b6", label="data"];
    ccap -- pin_in [penwidth=2.2, color="#2e75b6"];
    pin_drv -- drv; pin_rx -- rx; pin_cm -- cm; pin_prot -- prot;
    nochoke -- act [penwidth=2.2, color="#c00000", style=dotted,
                    label="power"];
    act -- poe [penwidth=2.2, color="#c00000", style=dotted];
    ctl -- c_out -- q1 -- q2 -- act [style=dashed, color="#c00000"];
    rj45 -- term [style=dashed, color="#595959"];
    ccap -- clamp [style=dashed, color="#595959"];
}
