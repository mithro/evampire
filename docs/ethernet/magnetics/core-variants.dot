// One channel of 8-core and 12-core magnetics. Both have a transformer
// and a common-mode choke on the cable side; 12-core parts add a
// centre-tapped autotransformer across the pair.
//
// Fixed grid, positions in inches. Top: 8-core. Bottom: 12-core.
//
// SPDX-License-Identifier: Apache-2.0

graph core_variants {
    graph [layout=neato, splines=false, outputorder=edgesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true, height=0.55];
    edge  [penwidth=1.5];

    node [shape=plaintext, style="", width=3.4, height=0.25, fontsize=10];
    h1 [pos="2.6,2.35!", label="8-core: two cores on each pair"];
    h2 [pos="2.6,1.1!", label="12-core: three cores on each pair"];

    node [shape=box, style=filled, fontsize=9, width=1.0, height=0.55];
    p1 [pos="0.5,1.8!", fillcolor="#dbe8f5", width=0.8, label="trans-\nceiver"];
    x1 [pos="1.75,1.8!", fillcolor="#fff2cc", label="transformer"];
    c1 [pos="3.05,1.8!", fillcolor="#e2efda", label="common-\nmode choke"];
    r1 [pos="4.4,1.8!", fillcolor="#f2f2f2", width=0.8, label="RJ45"];
    p1 -- x1 -- c1 -- r1;

    p2 [pos="0.5,0.5!", fillcolor="#dbe8f5", width=0.8, label="trans-\nceiver"];
    x2 [pos="1.75,0.5!", fillcolor="#fff2cc", label="transformer"];
    c2 [pos="3.05,0.5!", fillcolor="#e2efda", label="common-\nmode choke"];
    a2 [pos="3.05,-0.3!", fillcolor="#e4dcef", width=1.6, height=0.5,
        label="autotransformer across\nthe pair, centre tapped"];
    r2 [pos="4.4,0.5!", fillcolor="#f2f2f2", width=0.8, label="RJ45"];
    p2 -- x2 -- c2 -- r2;

    node [shape=point, width=0.07, height=0.07, fillcolor="#000000"];
    j2 [pos="3.75,0.5!"];
    node [shape=point, width=0.01, height=0.01, style=invis];
    k2 [pos="3.75,-0.3!"];
    j2 -- k2 -- a2;
}
