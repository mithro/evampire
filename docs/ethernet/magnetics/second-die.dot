// Two ways to split the transceiver between evampire and a second die at
// cable potential, and what crosses the barrier in each.
//
// Fixed grid, positions in inches. Top: whole transceiver on the
// cable-side die. Bottom: only the line driver and receiver there.
//
// SPDX-License-Identifier: Apache-2.0

digraph second_die {
    graph [layout=neato, splines=false, outputorder=nodesfirst,
           fontname="Helvetica", fontsize=10];
    node  [fontname="Helvetica", fontsize=9, pin=true, shape=box,
           style=filled, fixedsize=true];
    edge  [penwidth=1.5, arrowsize=0.6, dir=both];

    node [shape=plaintext, style="", width=4.6, height=0.22, fontsize=10];
    h1 [pos="2.7,2.75!", label="Whole transceiver on the cable-side die"];
    h2 [pos="2.7,1.25!", label="Only the line driver and receiver there"];

    node [shape=box, style=filled, height=0.75];
    e1 [pos="0.6,2.1!", width=1.0, fillcolor="#dbe8f5",
        label="evampire:\nforwarding\nlogic"];
    d1 [pos="3.9,2.1!", width=1.6, fillcolor="#fbe5d6",
        label="cable-side die:\nconverters, signal\nprocessing, driver,\nreceiver"];
    k1 [pos="5.15,2.1!", width=0.55, fillcolor="#f2f2f2", label="cable"];
    e2 [pos="0.75,0.6!", width=1.3, fillcolor="#dbe8f5",
        label="evampire:\nforwarding logic,\nsignal processing,\nconverters"];
    d2 [pos="3.9,0.6!", width=1.6, fillcolor="#fbe5d6",
        label="cable-side die:\nline driver and\nreceiver"];
    k2 [pos="5.15,0.6!", width=0.55, fillcolor="#f2f2f2", label="cable"];

    node [shape=plaintext, style="", width=1.9, height=0.35, fontsize=9];
    l1 [pos="1.95,2.42!", label="byte interface: 8 bits each\nway at 125 MHz, 1 Gbit/s"];
    l2 [pos="2.15,0.92!", label="converter samples:\nseveral times\nmore data"];
    l3 [pos="2.7,-0.1!", width=4.8,
        label="power crosses too: from Power over Ethernet or an isolated supply"];

    node [shape=point, width=0.01, height=0.01, style=invis];
    b1 [pos="2.9,2.55!"]; b2 [pos="2.9,1.55!"];
    b3 [pos="2.9,1.05!"]; b4 [pos="2.9,0.15!"];
    b1 -> b2 [dir=none, style=dashed, color="#7f7f7f"];
    b3 -> b4 [dir=none, style=dashed, color="#7f7f7f"];

    e1 -> d1 [color="#1f4e79"];
    d1 -> k1 [dir=none];
    e2 -> d2 [color="#c55a11", penwidth=3];
    d2 -> k2 [dir=none];
}
