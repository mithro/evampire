// The clocks of one integrated transceiver port: a 25 MHz reference
// multiplied to the 125 MHz symbol clock by a PLL, and a phase
// interpolator that sets the ADC sampling phase under the control of a
// digital timing-recovery loop. The slave transmits on the recovered
// phase; the master transmits on its PLL clock.
//
// SPDX-License-Identifier: Apache-2.0

digraph clockloop {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,3.0"];
    node  [shape=box, style="rounded,filled", fillcolor="#fbe5d6",
           fontname="Helvetica", fontsize=11, width=1.5, height=0.62,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.5];

    xtal [pos="0.85,2.4!", width=1.6, label="25 MHz crystal\n±50 ppm, plus\n±50 ppm ageing",
          height=0.8, fillcolor="#ffffff"];
    pll  [pos="2.9,2.4!", width=1.3, label="PLL, × 5"];
    pi   [pos="5.0,2.4!", width=1.5, label="Phase\ninterpolator"];
    adc  [pos="6.9,2.4!", width=1.1, label="ADC"];
    tr   [pos="5.0,0.9!", width=1.7, label="Digital timing\nrecovery", fillcolor="#e2efda"];
    tx   [pos="2.9,0.9!", width=1.5, label="Transmitter", fillcolor="#f2f2f2"];
    rx   [pos="6.9,0.9!", width=1.1, label="Received\nsamples", fillcolor="#ffffff"];

    xtal -> pll;
    pll  -> pi;
    pi   -> adc;
    l1 [pos="3.9,2.95!", shape=plaintext, style="", width=1.4, height=0.35,
        fontsize=9, label="125 MHz,\n±100 ppm"];
    l2 [pos="6.05,2.95!", shape=plaintext, style="", width=1.0, height=0.35,
        fontsize=9, label="sampling\nclock"];
    adc  -> rx;
    rx   -> tr;
    tr   -> pi  [style=dashed, label=" phase\n setting"];
    pll  -> tx  [label=" master  "];
    pi   -> tx  [style=dashed, label=" slave"];
}
