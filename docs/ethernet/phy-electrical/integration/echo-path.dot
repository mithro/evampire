// The path of the transceiver's own signal (the echo) through the receiver.
// Each stage removes part of it; what the analogue stages leave sets the
// input range the ADC must handle.
//
// SPDX-License-Identifier: Apache-2.0

digraph echopath {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,2.2"];
    node  [shape=box, style="rounded,filled", fillcolor="#fbe5d6",
           fontname="Helvetica", fontsize=10, width=1.15, height=0.7,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.5];

    pins  [pos="0.6,1.4!", width=1.0, label="Pins:\nfar-end +\nfull echo",
           fillcolor="#ffffff"];
    hyb   [pos="2.0,1.4!", label="Hybrid"];
    ana   [pos="3.4,1.4!", width=1.25, label="Analogue echo\ncanceller\n(optional)",
           style="rounded,dashed,filled"];
    adc   [pos="4.8,1.4!", label="Amplifier\nand ADC"];
    dig   [pos="6.3,1.4!", width=1.3, label="Digital echo\ncanceller", fillcolor="#f2f2f2"];
    sym   [pos="4.8,0.3!", width=1.6, height=0.45, label="Symbols sent",
           fillcolor="#f2f2f2"];

    pins -> hyb;
    hyb  -> ana;
    ana  -> adc;
    adc  -> dig;
    sym  -> ana [style=dashed];
    sym  -> dig [style=dashed, xlabel="sent symbols"];
}
