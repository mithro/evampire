// Simplified block sketches of the three ADC families that receiver.rst
// lists as options: folding, pipelined with time interleaving, and
// interleaved successive approximation (SAR).
//
// SPDX-License-Identifier: Apache-2.0

digraph adcs {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,3.6"];
    node  [shape=box, style="rounded,filled", fillcolor="#fbe5d6",
           fontname="Helvetica", fontsize=10, width=1.25, height=0.55,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.4];

    h1 [pos="0.4,3.5!", shape=plaintext, style="", width=1.6, height=0.25,
        fontsize=11, fontname="Helvetica-Bold", label="Folding"];
    f_in [pos="0.4,2.9!", width=0.6, label="Input", fillcolor="#ffffff"];
    f_fold [pos="1.75,2.9!", label="Folding\namplifiers"];
    f_fine [pos="3.25,2.9!", label="Fine\ncomparators"];
    f_coarse [pos="3.25,2.2!", label="Coarse\ncomparators"];
    f_enc [pos="4.75,2.55!", label="Encoder"];
    f_in -> f_fold; f_fold -> f_fine; f_in -> f_coarse;
    f_fine -> f_enc; f_coarse -> f_enc;

    h2 [pos="1.12,1.55!", shape=plaintext, style="", width=2.6, height=0.25,
        fontsize=11, fontname="Helvetica-Bold", label="Pipelined, time-interleaved"];
    p_in [pos="0.4,0.95!", width=0.6, label="Input", fillcolor="#ffffff"];
    p_s1 [pos="1.75,0.95!", label="Stage 1:\nfew bits, residue"];
    p_s2 [pos="3.25,0.95!", label="Stage 2:\nfew bits, residue"];
    p_sn [pos="4.75,0.95!", label="… last stage"];
    p_x [pos="6.25,0.95!", width=1.5, shape=plaintext, style="",
         label="Several copies\ntake turns to\nreach 125 MS/s"];
    p_in -> p_s1; p_s1 -> p_s2; p_s2 -> p_sn; 

    h3 [pos="1.0,0.25!", shape=plaintext, style="", width=2.3, height=0.25,
        fontsize=11, fontname="Helvetica-Bold", label="Successive approximation"];
    s_in [pos="0.4,-0.35!", width=0.6, label="Input", fillcolor="#ffffff"];
    s_cmp [pos="1.75,-0.35!", label="One\ncomparator"];
    s_log [pos="3.25,-0.35!", label="Bit-by-bit\nlogic"];
    s_dac [pos="2.5,-1.05!", label="Capacitor DAC"];
    s_x [pos="4.75,-0.35!", width=1.5, shape=plaintext, style="",
         label="Several copies\ntake turns"];
    s_in -> s_cmp; s_cmp -> s_log; s_log -> s_dac; s_dac -> s_cmp;
}
