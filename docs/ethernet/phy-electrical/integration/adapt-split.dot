// Adaptation split from filtering: the filters run in hardware at the
// symbol rate and collect error terms; an update engine, in slower
// hardware or software on the processor, updates the coefficients K times
// less often and writes them back.
//
// SPDX-License-Identifier: Apache-2.0

digraph adaptsplit {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,2.4"];
    node  [shape=box, style="rounded,filled", fillcolor="#dbe8f5",
           fontname="Helvetica", fontsize=11, width=2.2, height=0.7,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.5];

    in  [pos="0.5,1.6!", width=0.9, label="Samples", fillcolor="#ffffff"];
    flt [pos="2.6,1.6!", label="Filters in hardware,\nevery 8 ns symbol"];
    out [pos="4.7,1.6!", width=1.0, label="Equalised\nsamples", fillcolor="#ffffff"];
    upd [pos="2.6,0.2!", width=3.2, label="Update engine: slower hardware or\nsoftware, K times less often",
         fillcolor="#e2efda"];

    in  -> flt;
    flt -> out;
    e1 [pos="2.1,1.25!", shape=point, width=0.01];
    e2 [pos="2.1,0.55!", shape=point, width=0.01];
    c1 [pos="3.1,0.55!", shape=point, width=0.01];
    c2 [pos="3.1,1.25!", shape=point, width=0.01];
    e1 -> e2;
    c1 -> c2 [style=dashed];
    l0 [pos="1.4,0.9!", shape=plaintext, style="", width=1.0, height=0.3,
        fontsize=9, label="error terms"];
    l1 [pos="3.85,0.9!", shape=plaintext, style="", width=1.3, height=0.3,
        fontsize=9, label="new coefficients"];
    n1 [pos="5.6,0.2!", shape=plaintext, style="", width=2.2, height=0.7,
        fontsize=9, label="K = 1000: 1.1 × 10⁸ updates/s;\n44 000 updates per\ncoefficient in 350 ms"];
}
