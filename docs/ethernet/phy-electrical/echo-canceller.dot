// An adaptive FIR echo canceller. The symbols the transceiver has sent
// pass along a delay line of one symbol period per stage; each tap
// multiplies one past symbol by a coefficient, and the sum predicts the
// echo, which is subtracted from the ADC samples. The remaining error
// adapts the coefficients by least-mean-squares.
//
// SPDX-License-Identifier: Apache-2.0

digraph echocanceller {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,3.6"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=0.7, height=0.45,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.4];

    sym [pos="0.2,3.2!", shape=plaintext, style="", width=1.1, label="Symbols\nsent"];
    j0  [pos="1.1,3.2!", shape=point, width=0.07];
    d1  [pos="2.0,3.2!", label="8 ns"];
    j1  [pos="2.9,3.2!", shape=point, width=0.07];
    d2  [pos="3.8,3.2!", label="8 ns"];
    j2  [pos="4.7,3.2!", shape=point, width=0.07];
    dots [pos="5.5,3.2!", shape=plaintext, style="", width=0.6, label="…"];
    jn  [pos="6.3,3.2!", shape=point, width=0.07];

    m0 [pos="1.1,2.2!", shape=circle, width=0.5, height=0.5, fillcolor="#fbe5d6", label="× c₀"];
    m1 [pos="2.9,2.2!", shape=circle, width=0.5, height=0.5, fillcolor="#fbe5d6", label="× c₁"];
    m2 [pos="4.7,2.2!", shape=circle, width=0.5, height=0.5, fillcolor="#fbe5d6", label="× c₂"];
    mn [pos="6.3,2.2!", shape=circle, width=0.5, height=0.5, fillcolor="#fbe5d6", label="× cₙ"];

    sum [pos="3.7,1.15!", shape=circle, width=0.45, height=0.45, fillcolor="#ffffff", label="Σ", fontsize=14];
    sub [pos="3.7,0.2!", shape=circle, width=0.45, height=0.45, fillcolor="#ffffff", label="−", fontsize=16];
    adc [pos="1.4,0.2!", width=1.5, label="ADC samples:\nfar-end + echo", fillcolor="#ffffff"];
    out [pos="6.1,0.2!", width=1.6, label="Far-end signal\nand error", fillcolor="#ffffff"];
    lms [pos="6.1,1.15!", width=1.6, label="Least-mean-\nsquares update", fillcolor="#e2efda"];

    sym -> j0 [arrowhead=none];
    j0 -> d1;
    d1 -> j1 [arrowhead=none];
    j1 -> d2;
    d2 -> j2 [arrowhead=none];
    j2 -> dots [arrowhead=none];
    dots -> jn [arrowhead=none];
    j0 -> m0;
    j1 -> m1;
    j2 -> m2;
    jn -> mn;
    m0 -> sum;
    m1 -> sum;
    m2 -> sum;
    mn -> sum;
    sum -> sub [label="  predicted echo"];
    adc -> sub [label="+"];
    sub -> out;
    out -> lms [style=dashed, color="#2e7d32"];
    lms -> mn [style=dashed, color="#2e7d32", label=" all coefficients"];
}
