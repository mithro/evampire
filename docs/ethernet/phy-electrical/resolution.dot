// How each end of a 1000BASE-T link decides which end is master, from
// the information in the next pages. Both ends apply the same rules.
//
// SPDX-License-Identifier: Apache-2.0

digraph resolution {
    graph [layout=neato, splines=false, overlap=true, fontname="Helvetica",
           size="7.4,4.2"];
    node  [shape=box, style="rounded,filled", fillcolor="#f2f2f2",
           fontname="Helvetica", fontsize=11, width=2.2, height=0.6,
           fixedsize=true];
    edge  [fontname="Helvetica", fontsize=10, arrowsize=0.7, penwidth=1.4];

    q1 [pos="1.6,4.0!", shape=diamond, width=2.6, height=0.9,
        label="Either end set\nby hand?", fillcolor="#fbe5d6"];
    q1b [pos="5.4,4.0!", shape=diamond, width=2.4, height=0.9,
         label="Both set to\nthe same role?", fillcolor="#fbe5d6"];
    q2 [pos="1.6,2.3!", shape=diamond, width=2.6, height=0.9,
        label="One multiport,\none single-port?", fillcolor="#fbe5d6"];
    q3 [pos="1.6,1.0!", shape=diamond, width=2.6, height=0.9,
        label="Seeds equal?", fillcolor="#fbe5d6"];

    fault [pos="5.4,5.2!", label="Configuration fault", fillcolor="#f4cccc"];
    manual [pos="5.4,3.05!", label="The set roles apply", fillcolor="#e2efda"];
    multi [pos="4.4,2.3!", label="Multiport end\nbecomes master", fillcolor="#e2efda"];
    seed [pos="4.4,1.0!", label="Larger seed\nbecomes master", fillcolor="#e2efda"];
    retry [pos="1.6,-0.2!", width=2.6, label="New seeds, negotiate again;\nfault after 7 failures"];

    q1 -> q1b [label="yes"];
    q1b -> fault [label=" yes"];
    q1b -> manual [label=" no"];
    q1 -> q2 [label=" no"];
    q2 -> multi [label="yes"];
    q2 -> q3 [label=" no"];
    q3 -> seed [label="no"];
    q3 -> retry [label=" yes"];
}
