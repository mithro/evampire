// evampire at a glance: the main blocks, how data and power flow between
// them, and the edge of the chip in each board configuration.
//
// Thick blue lines: data. Thick orange lines: power. Dashed grey lines:
// control. Data runs left to right along the top row, from Ethernet port A to
// Ethernet port B. Power runs left to right along the bottom row, in at port A
// and out at port B, with a branch down to and up from USB Type-C.
//
// Blocks are pinned on a grid (positions in inches). Edges that must leave a
// block away from its centre run between invisible anchor points ("a_*")
// pinned on the block outlines, so that every line is horizontal or vertical:
//
//   row y=7.0   data path: port A, transceiver A, hub, transceiver B, port B
//   row y=5.75  RISC-V management processor
//   row y=4.55  USB serial and USB-PD interface, power control
//   row y=2.9   power path: PoE powered device, buck, power bus, boost,
//               PoE power sourcing equipment
//   row y=1.65  USB-PD sink switch, USB-PD source converter
//   row y=0.45  USB Type-C port
//
// SPDX-License-Identifier: Apache-2.0

digraph overview {
    graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
           fontname="Helvetica", bgcolor="#ffffff", pad=0.1];
    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=13, fixedsize=true, width=1.3, height=0.62,
           color="#4a5568", fontcolor="#1a202c", penwidth=1.2];
    edge  [arrowsize=0.7, penwidth=3.2];

    // Anchor points: invisible, so only the edges between them show.
    node [shape=point, style=invis, width=0.01, height=0.01, fixedsize=true];
    a_ad  [pos="1.1,7.0!"];    // port A, data side
    a_ap  [pos="1.1,2.9!"];    // port A, power side
    a_bd  [pos="9.4,7.0!"];    // port B, data side
    a_bp  [pos="9.4,2.9!"];    // port B, power side
    a_cu  [pos="4.6,5.4!"];    // processor, bottom, above the USB interface
    a_cp  [pos="5.9,5.4!"];    // processor, bottom, above power control
    a_iu  [pos="4.6,4.9!"];    // USB interface, top
    a_pc  [pos="5.9,4.9!"];    // power control, top
    a_id  [pos="4.2,4.2!"];    // USB interface, bottom
    a_pd  [pos="6.3,4.2!"];    // power control, bottom
    a_st  [pos="6.3,3.45!"];   // power stages outline, top
    a_cd  [pos="4.2,0.7!"];    // USB Type-C port, top, data
    a_bs  [pos="4.9,2.59!"];   // power bus, bottom, to the sink switch
    a_bo  [pos="6.0,2.59!"];   // power bus, bottom, to the source converter
    a_ss  [pos="4.9,1.34!"];   // sink switch, bottom
    a_st2 [pos="4.9,1.96!"];   // sink switch, top
    a_so  [pos="6.0,1.3!"];    // source converter, bottom
    a_so2 [pos="6.0,2.0!"];    // source converter, top
    a_cs  [pos="4.9,0.7!"];    // USB Type-C port, top, sink
    a_co  [pos="6.0,0.7!"];    // USB Type-C port, top, source

    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=13, fixedsize=true, width=1.3, height=0.62,
           color="#4a5568", fontcolor="#1a202c", penwidth=1.2];

    // ---- Stage outlines, drawn first so they sit behind the blocks. ----
    full   [label="", pos="5.25,5.925!", width=7.8, height=4.45,
            style="rounded,dashed", color="#1f4e79", penwidth=1.8];
    first  [label="", pos="5.25,5.85!", width=3.7, height=3.85,
            style="rounded,filled,bold", fillcolor="#eef4fb",
            color="#1f4e79", penwidth=2.6];
    stages [label="", pos="5.25,2.2!", width=8.0, height=2.5,
            style="rounded,dotted", color="#9c4221", penwidth=2.0];

    full_lbl   [shape=plaintext, style="", fixedsize=false, fontsize=12,
                fontcolor="#1f4e79", pos="2.4,7.7!",
                label=<<b>Full design:</b><br/>transceivers<br/>on chip too>];
    first_lbl  [shape=plaintext, style="", fixedsize=false, fontsize=12,
                fontcolor="#1f4e79", pos="5.25,7.55!",
                label=<<b>evampire chip: first version</b>>];
    stages_lbl [shape=plaintext, style="", fixedsize=false, fontsize=12,
                fontcolor="#9c4221", pos="2.55,1.55!",
                label=<<b>Power stages:</b><br/>on the chip or<br/>external parts<br/>(open question)>];
    rgmii_a    [shape=plaintext, style="", fixedsize=false, fontsize=11,
                fontcolor="#2b6cb0", pos="3.8,6.8!", label="RGMII"];
    rgmii_b    [shape=plaintext, style="", fixedsize=false, fontsize=11,
                fontcolor="#2b6cb0", pos="6.7,6.8!", label="RGMII"];

    // ---- Connectors on the board, outside the chip. ----
    port_a [pos="0.6,4.95!", width=1.0, height=4.9, fillcolor="#ffffff",
            penwidth=1.6, label="Ethernet\nport A\n(RJ45)\n\n\ndata\nand\npower\nin"];
    port_b [pos="9.9,4.95!", width=1.0, height=4.9, fillcolor="#ffffff",
            penwidth=1.6, label="Ethernet\nport B\n(RJ45)\n\n\ndata\nand\npower\nout"];
    usbc   [pos="5.25,0.45!", width=3.3, height=0.5, fillcolor="#ffffff",
            penwidth=1.6, label="USB Type-C port"];

    // ---- Data path. ----
    phy_a [pos="2.4,7.0!", width=1.5, fillcolor="#dbe8f5",
           label="Ethernet\ntransceiver A"];
    hub   [pos="5.25,7.0!", width=1.9, fillcolor="#dbe8f5",
           label="Cut-through\nEthernet hub"];
    phy_b [pos="8.1,7.0!", width=1.5, fillcolor="#dbe8f5",
           label="Ethernet\ntransceiver B"];

    // ---- Processor and its interfaces. ----
    cpu   [pos="5.25,5.75!", width=2.0, height=0.7, fillcolor="#e9d8fd",
           label="RISC-V management\nprocessor"];
    usbif [pos="4.2,4.55!", width=1.35, height=0.7, fillcolor="#e9d8fd",
           fontsize=12, label="USB serial port\nand USB-PD\n(D+, D−, CC)"];
    pwrc  [pos="6.3,4.55!", width=1.35, height=0.7, fillcolor="#e9d8fd",
           fontsize=12, label="Power control\nand monitoring"];

    // ---- Power path. ----
    poe_sink [pos="2.0,2.9!", width=1.25, height=0.7, fillcolor="#feebc8",
              fontsize=12, label="PoE\npowered\ndevice"];
    buck     [pos="3.4,2.9!", width=1.1, fillcolor="#feebc8",
              label="Buck\nconverter"];
    bus      [pos="5.4,2.9!", width=1.7, fillcolor="#fbd38d",
              style="rounded,filled,bold", label="Power bus"];
    boost    [pos="7.0,2.9!", width=1.1, fillcolor="#feebc8",
              label="Boost\nconverter"];
    poe_src  [pos="8.45,2.9!", width=1.35, height=0.7, fillcolor="#feebc8",
              fontsize=12, label="PoE power\nsourcing\nequipment"];
    usb_sink [pos="4.9,1.65!", width=1.0, fillcolor="#feebc8",
              fontsize=12, label="USB-PD\nsink switch"];
    usb_src  [pos="6.0,1.65!", width=1.0, height=0.7, fillcolor="#feebc8",
              fontsize=12, label="USB-PD\nsource\nbuck-boost"];

    // ---- Data: straight along the top row, down to the processor, and
    // down again to USB. ----
    a_ad  -> phy_a [dir=both, color="#2b6cb0"];
    phy_a -> hub   [dir=both, color="#2b6cb0"];
    hub   -> phy_b [dir=both, color="#2b6cb0"];
    phy_b -> a_bd  [dir=both, color="#2b6cb0"];
    hub   -> cpu   [dir=both, color="#2b6cb0"];
    a_cu  -> a_iu  [dir=both, color="#2b6cb0", penwidth=2.2];
    a_id  -> a_cd  [dir=both, color="#2b6cb0", penwidth=2.2];

    // ---- Power: straight along the bottom row, in at A and out at B, with
    // the USB branch below the bus. ----
    a_ap     -> poe_sink [color="#dd6b20"];
    poe_sink -> buck     [color="#dd6b20"];
    buck     -> bus      [color="#dd6b20"];
    bus      -> boost    [color="#dd6b20"];
    boost    -> poe_src  [color="#dd6b20"];
    poe_src  -> a_bp     [color="#dd6b20"];
    a_cs     -> a_ss     [color="#dd6b20"];
    a_st2    -> a_bs     [color="#dd6b20"];
    a_bo     -> a_so2    [color="#dd6b20"];
    a_so     -> a_co     [color="#dd6b20"];

    // ---- Legend, to the right of the USB Type-C port. ----
    node [shape=point, style=invis, width=0.01, height=0.01, fixedsize=true];
    l_d1 [pos="7.55,0.75!"]; l_d2 [pos="8.15,0.75!"];
    l_p1 [pos="7.55,0.45!"]; l_p2 [pos="8.15,0.45!"];
    l_c1 [pos="7.55,0.15!"]; l_c2 [pos="8.15,0.15!"];
    node [shape=plaintext, style="", fixedsize=false, fontsize=12,
          fontcolor="#1a202c"];
    l_dt [pos="8.65,0.75!", label="data"];
    l_pt [pos="8.65,0.45!", label="power"];
    l_ct [pos="8.65,0.15!", label="control"];
    l_d1 -> l_d2 [color="#2b6cb0", dir=both];
    l_p1 -> l_p2 [color="#dd6b20"];
    l_c1 -> l_c2 [style=dashed, color="#718096", penwidth=1.6];

    // ---- Control. ----
    a_cp -> a_pc [style=dashed, color="#718096", penwidth=1.6];
    a_pd -> a_st [style=dashed, color="#718096", penwidth=1.6, dir=both];
}
