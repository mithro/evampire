* 10 diode-connected nfet_05v0 in series, variant A_shared_substrate
.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical

VIN n0 0 0
VBOT n10 0 0
VSUB sub 0 0

XM1 n0 n0 n1 sub nfet_05v0 w=1e-05 l=6e-07 ad=1.8e-12 as=1.8e-12 pd=2.036e-05 ps=2.036e-05
DJD1 sub n0 diode_nd2ps_06v0 area=1.8e-12 pj=2.036e-05
DJS1 sub n1 diode_nd2ps_06v0 area=1.8e-12 pj=2.036e-05
